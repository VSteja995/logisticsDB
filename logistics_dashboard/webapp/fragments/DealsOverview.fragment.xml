<core:FragmentDefinition 
    xmlns:layout="sap.ui.layout" 
    xmlns:ld="sap.ui.core.LayoutData"
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:f="sap.f">
<Panel id="DlPnl1Pnl001" class="sapUiSmallMargin">
    <Title id="DlPnl1Ttl002" text="O/E Schedule" level="H3" class="sapUiTinyMargin" />
            <HBox id="DlPnl1Hbx003"  alignItems="Center" justifyContent="SpaceBetween" class="filterContainer sapUiSmallMargin">
                    <Label id="DlPnl1Lbl004"  text="DateRange :"></Label>
                    <DateRangeSelection id="DlPnl1DRS005"
                        displayFormat="MM/dd/yyyy"
                        placeholder="MM/DD/YYYY - MM/DD/YYYY"
                        change=".onOEScheduleDateRangeChange" />
                    <Label id="DlPnl1Lbl006"  text="Mode :"></Label>
                    <SegmentedButton id="DlPnl1SgB007" selectedKey="All" selectionChange=".onModeChange" >
                        <items>
                            <SegmentedButtonItem id="DlPnl1SBI008" key="Train" text="Rail"  icon="sap-icon://cargo-train" />
                            <SegmentedButtonItem id="DlPnl1SBI009" key="Truck" text="Truck" icon="sap-icon://shipping-status" />
                        </items>
                    </SegmentedButton>
                     <Label id="DlPnl1Lbl010"  text="Commodity :"></Label>
                    <MultiComboBox id="DlPnl1Cbo011" placeholder="Select Commodity" width="100%" selectionChange="onCommodityFilterChange" selectionFinish="onCommoditySelectionFinish" items="{UniqDealCmdtyData>/UniqDealCmdtySet}">
                        <items>
                            <core:Item id="DlPnl1Ite012" key="{UniqDealCmdtyData>Commodity}" text="{UniqDealCmdtyData>CommodityDesc}"/>
                            
                            </items>
                    </MultiComboBox>
                     <Label id="DlPnl1Lbl014"  text="Market   Zone :"></Label>
                    <MultiComboBox id="DlPnl1Cbo015" placeholder="All Zones" width="100%" >
                        <items>
                            
                            </items>
                    </MultiComboBox>
                    
            </HBox>
           
    
    <f:GridContainer id="DlPnl1Grd018" snapToRow="true"
        items="{dealQtyMotData>/DealQtyMotSet}"
        class="sapUiSmallMargin">
        <f:items>
            <VBox id="DlPnl1Vbx019" class="sapUiTinyMargin">
                <layoutData>
                <f:GridContainerItemLayoutData id="DlPnl1Gri020" minRows="1" columns="5" />
                </layoutData>
                <Title id="DlPnl1Ttl021" text="{= ['January','February','March','April','May','June','July','August','September','October','November','December']
                [ parseInt(${dealQtyMotData>ScheduleMonth}, 10) - 1 ] }" />
                
                <ScrollContainer id="DlPnl1Scr022" height="160px" vertical="true" horizontal="false" width="100%">
<Table id="DlPnl1Tbl023" class="cardTable" fixedLayout="false">
    <columns>
        <Column id="DlPnl1Col024" width="40%" ><Text id="DlPnl1Txt025" text="Commodity" /></Column>
        <Column id="DlPnl1Col026" width="30%" ><Text id="DlPnl1Txt027" text="Purch | Planned" wrapping="false" /></Column>
        <Column id="DlPnl1Col028" width="30%" ><Text id="DlPnl1Txt029" text="Sales | Planned" wrapping="false" /></Column>
    </columns>
    <items>
        <ColumnListItem id="DlPnl1ClL030" vAlign="Inherit">
            <cells>
                <Text id="DlPnl1Txt031" text="{dealQtyMotData>Commodity}" />
                <Text id="DlPnl1Txt032" text="{dealQtyMotData>Purchase} | {dealQtyMotData>PlannedPurchase}" />
                <Text id="DlPnl1Txt033" text="{dealQtyMotData>Sale} | {dealQtyMotData>PlannedSale}" />
            </cells>
        </ColumnListItem>
    </items>
</Table>
                </ScrollContainer>
            </VBox>
        </f:items>
    </f:GridContainer>

</Panel>
<Panel id="DlPnl2Pnl034" class="sapUiSmallMargin">
<OverflowToolbar id="DlPnl2Tbr035">
    <ToolbarSpacer id="DlPnl2Too036" />          
    
    <Button id="DlPnl2Btn037" text="Create Deal" icon="sap-icon://add" type="Emphasized" press="navToCreateDeals" />
    <Button id="DlPnl2Btn038" text="Edit Deal" icon="sap-icon://edit" type="Transparent" press="navToEditDeals"/>
    <Button id="DlPnl2Btn039" text="Search Deal" icon="sap-icon://search" type="Transparent" press="navToEditDeals"/>
    <Button id="DlPnl2Btn040"  icon="sap-icon://refresh" type="Ghost" press=""/>
</OverflowToolbar>
<VBox id="DlPnl2Vbx041">
    <OverflowToolbar id="DlPnl2Tbr042">
        <Title id="DlPnl2Ttl043" text="Deals Details( )"  />
        <ToolbarSpacer id="DlPnl2Too044"></ToolbarSpacer>
            <MenuButton id="DlPnl2Mnu045"
            icon="sap-icon://excel-attachment" type="Transparent">
            <menu>
            <Menu id="DlPnl2Mnu046"  >
            <MenuItem id="DlPnl2MnI047"  text="Export" press=".onExport"/>
            <MenuItem id="DlPnl2MnI048"  text="Export As." press=".onExportAs"/>
            </Menu>
            </menu>
            </MenuButton>
 
        <Button id="DlPnl2Btn049" press="onFullScreenToggle" icon="sap-icon://full-screen" type="Transparent"/>
    </OverflowToolbar>
<!-- Table Header section& Button -->
    <ScrollContainer id="DlPnl2Scr050" height="280px" class="dealsTableWrapper" horizontal="true" vertical="true" width="100%">
    <Table id="DlPnl2Tbl051" mode="MultiSelect" fixedLayout="false" items="{DealDetailData>/DealDetailSet}" >
        <!-- Table Body  -->
        <columns>
            <Column id="DlPnl2Col052">
                <header>
                    <Text id="DlPnl2Txt053" text="Deal ID" />
                </header>
            </Column>
            <Column id="DlPnl2Col054">
                <header>
                    <Text id="DlPnl2Txt055" text="CounterParty" />
                </header>
            </Column>
            <Column id="DlPnl2Col056">
                <header>
                    <Text id="DlPnl2Txt057" text="CounterParty Name" />
                </header>
            </Column>
            <Column id="DlPnl2Col058">
                <header>
                    <Text id="DlPnl2Txt059" text="Deal Type" />
                </header>
            </Column>
            <Column id="DlPnl2Col060">
                <header>
                    <Text id="DlPnl2Txt061" text="Commodity" />
                </header>
            </Column>
            <Column id="DlPnl2Col062">
                <header>
                    <Text id="DlPnl2Txt063" text="Status" />
                </header>
            </Column>
            <Column id="DlPnl2Col064">
                <header>
                    <Text id="DlPnl2Txt065" text="Contract Number" />
                </header>
            </Column>
            <Column id="DlPnl2Col066">
                <header>
                    <Text id="DlPnl2Txt067" text="Trade Date" />
                </header>
            </Column>
            <Column id="DlPnl2Col068">
                <header>
                    <Text id="DlPnl2Txt069" text="Valid From" />
                </header>
            </Column>
            <Column id="DlPnl2Col070">
                <header>
                    <Text id="DlPnl2Txt071" text="Valid To" />
                </header>
            </Column>
            <Column id="DlPnl2Col072">
                <header>
                    <Text id="DlPnl2Txt073" text="Schedule Date" />
                </header>
            </Column>
            <Column id="DlPnl2Col074">
                <header>
                    <Text id="DlPnl2Txt075" text="Schedule Quantity" />
                </header>
            </Column>
            <Column id="DlPnl2Col076">
                <header>
                    <Text id="DlPnl2Txt077" text="Called-of Quantity"/>
                </header>
            </Column>
            <Column id="DlPnl2Col078">
                <header>
                    <Text id="DlPnl2Txt079" text="Difference Quantity"/>
                </header>
            </Column>
            <Column id="DlPnl2Col080">
                <header>
                    <Text id="DlPnl2Txt081" text="Origin" />
                </header>
            </Column>
            <Column id="DlPnl2Col082">
                <header>
                    <Text id="DlPnl2Txt083" text="Origin ID" />
                </header>
            </Column>
            <Column id="DlPnl2Col084">
                <header>
                    <Text id="DlPnl2Txt085" text="Destination" />
                </header>
            </Column>
            <Column id="DlPnl2Col086">
                <header>
                    <Text id="DlPnl2Txt087" text="Destination ID" />
                </header>
            </Column>
           
            <Column id="DlPnl2Col092">
                <header>
                    <Text id="DlPnl2Txt093" text="MOT" />
                </header>
            </Column>
            <Column id="DlPnl2Col094">
                <header>
                    <Text id="DlPnl2Txt095" text="Pricing" />
                </header>
            </Column>
        </columns>
        <items>
        <ColumnListItem id="DlPnl2ClL096" type="Inactive">
            <cells>
                <Text id="DlPnl2Txt097" text="{DealDetailData>DealId}" />
                <Text id="DlPnl2Txt098" text="{DealDetailData>CounterParty}" />
                <Text id="DlPnl2Txt099" text="{DealDetailData>CounterPartyName}" />
                <Text id="DlPnl2Txt100" text="{DealDetailData>DealType}" />
                <Text id="DlPnl2Txt101" text="{DealDetailData>Commodity}" />
                <ObjectStatus id="DlPnl2Obj102" text="{DealDetailData>Status}" state="{= ${DealDetailData>Status} === 'Active' ? 'Success' : 'Warning'}" />
                <Text id="DlPnl2Txt103" text="{DealDetailData>ContractNumber}"/>
                <Text id="DlPnl2Txt104" text="{
                path: 'DealDetailData>TradeDate',
                type: 'sap.ui.model.type.Date', 
                formatOptions: {
                      pattern: 'yyyy/MMM/dd' 
                      }
                      }" />
                
                      <Text id="DlPnl2Txt108E"  text="{
                path: 'DealDetailData>DeliveryStart',
                type: 'sap.ui.model.type.Date', 
                formatOptions: {
                      pattern: 'yyyy/MMM/dd' 
                      }
                      }"/>
                      <Text id="DlPnl2Txt108A"  text="{
                path: 'DealDetailData>DeliveryEnd',
                type: 'sap.ui.model.type.Date', 
                formatOptions: {
                      pattern: 'yyyy/MMM/dd' 
                      }
                      }"/>
                      <Text id="DlPnl2Txt108"  text="{
                path: 'DealDetailData>ScheduleDate',
                type: 'sap.ui.model.type.Date', 
                formatOptions: {
                      pattern: 'yyyy/MMM/dd' 
                      }
                      }"/>
                <Text id="DlPnl2Txt109" text="{DealDetailData>ScheduleQty}" />
                <Text id="DlPnl2Txt110" text="{DealDetailData>CallOffQty}"/> 
                <Text id="DlPnl2Txt112" text="{DealDetailData>DiffQty}" />
                <Text id="DlPnl2Txt113" text="{DealDetailData>OriginName}" />
                <Text id="DlPnl2Txt114" text="{DealDetailData>Origin}" />
                <Text id="DlPnl2Txt115" text="{DealDetailData>DestinationName}" />
                <Text id="DlPnl2Txt116" text="{DealDetailData>Destination}" />
                <Text id="DlPnl2Txt117" text="{DealDetailData>ModeOfTransportText}" />

                <Text id="DlPnl2Txt118" text="{DealDetailData>Pricing}" />
            </cells>
        </ColumnListItem>
    </items>
    </Table>
    </ScrollContainer>
</VBox >
</Panel>
<HBox id="DlPnl2Hbx119" wrap="Wrap" class="sapUiContentPadding sapUiSmallMargin">
    <Panel id="DlPnl3Pnl120" class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="14rem">
        <VBox id="DlPnl3Vbx121" class="sapUiSmallMargin">
            <HBox id="DlPnl3Hbx122" justifyContent="SpaceBetween" alignItems="Center">
                <Title id="DlPnl3Ttl123" text="Active Deals" level="H6" titleStyle="H6"/>
                <Avatar id="DlPnl3Avt124" src="sap-icon://accept" displaySize="XS" displayShape="Square" class="sapFAvatarSuccess"/>
            </HBox>
            <NumericContent id="DlPnl3Num125" value="247" indicator="Up" valueColor="Good"/>
            <Text id="DlPnl3Txt126" text="+12%" class="sapUiTinyMarginTop"/>
        </VBox>
    </Panel>
    <Panel id="DlPnl4Pnl127" class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="14rem">
        <VBox id="DlPnl4Vbx128" class="sapUiSmallMargin">
            <HBox id="DlPnl4Hbx129" justifyContent="SpaceBetween" alignItems="Center">
                <Title id="DlPnl4Ttl130" text="Pending Obligations" level="H6" titleStyle="H6"/>
                <Avatar id="DlPnl4Avt131" src="sap-icon://exclamation" displaySize="XS" displayShape="Square" class="sapFAvatarWarning"/>
            </HBox>
            <NumericContent id="DlPnl4Num132" value="58" indicator="Down" valueColor="Critical"/>
            <Text id="DlPnl4Txt133" text="-5%" class="sapUiTinyMarginTop"/>
        </VBox>
    </Panel>
    <Panel id="DlPnl5Pnl134" class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="14rem">
        <VBox id="DlPnl5Vbx135" class="sapUiSmallMargin">
            <HBox id="DlPnl5Hbx136" justifyContent="SpaceBetween" alignItems="Center">
                <Title id="DlPnl5Ttl137" text="Fulfilled Entitlements" level="H6" titleStyle="H6"/>
                <Avatar id="DlPnl5Avt138" src="sap-icon://accept" displaySize="XS" displayShape="Square" class="sapFAvatarSuccess"/>
            </HBox>
            <NumericContent id="DlPnl5Num139" value="1,842" indicator="Up" valueColor="Good"/>
            <Text id="DlPnl5Txt140" text="+18%" class="sapUiTinyMarginTop"/>
        </VBox>
    </Panel>
    <Panel id="DlPnl6Pnl141" class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="14rem">
        <VBox id="DlPnl6Vbx142" class="sapUiSmallMargin">
            <HBox id="DlPnl6Hbx143" justifyContent="SpaceBetween" alignItems="Center">
                <Title id="DlPnl6Ttl144" text="Total Volume" level="H6" titleStyle="H6"/>
                <Avatar id="DlPnl6Avt145" src="sap-icon://bar-chart" displaySize="XS" displayShape="Square" class="sapFAvatarSuccess"/>
            </HBox>
            <NumericContent id="DlPnl6Num146" value="12.4k" indicator="Up" valueColor="Good"/>
            <Text id="DlPnl6Txt147" text="+8%" class="sapUiTinyMarginTop"/>
        </VBox>
    </Panel>
</HBox>

</core:FragmentDefinition>