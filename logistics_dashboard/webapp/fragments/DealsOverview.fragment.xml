<core:FragmentDefinition 
    xmlns:layout="sap.ui.layout" 
    xmlns:ld="sap.ui.core.LayoutData"
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:f="sap.f">
<Panel id="_IDGenPanel1" class="sapUiNoScroll">
    <Title id="_IDGenTitle11" text="O/E Schedule" level="H3" class="sapUiTinyMargin" />
            <HBox id="_IDGenHBox"  alignItems="Center" justifyContent="SpaceBetween" class="filterContainer sapUiSmallMargin">
                    <Label id="_IDGenLabel"  text="DateRange :"></Label>
                    <DateRangeSelection id="drS1"  placeholder="MM/DD/YYYY - MM/DD/YYYY" />
                    <Label id="_IDGenLabel1"  text="Mode :"></Label>
                    <SegmentedButton id="_IDGenSegmentedButton" selectedKey="All" >
                        <items>
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem" key="Train" icon="sap-icon://cargo-train" />
                            <SegmentedButtonItem id="_IDGenSegmentedButtonItem1" key="Truck" icon="sap-icon://shipping-status" />
                        </items>
                    </SegmentedButton>
                     <Label id="_IDGenLabel2"  text="Commodity :"></Label>
                    <MultiComboBox id="cbCommodity" placeholder="Select Commodity" width="100%" >
                        <items>
                            <core:Item id="_IDGenItem" key="GAS87" text="GAS87" />
                            <core:Item id="_IDGenItem1" key="GAS88" text="GAS88" />
                            </items>
                    </MultiComboBox>
                     <Label id="_IDGenLabel3"  text="Market   Zone :"></Label>
                    <MultiComboBox id="cbMarketZone" placeholder="All Zones" width="100%" >
                        <items>
                            <core:Item id="_IDGenItem2" key="GAS87" text="GAS87" />
                            <core:Item id="_IDGenItem3" key="GAS88" text="GAS88" />
                            </items>
                    </MultiComboBox>
            </HBox>
           
    
    <f:GridContainer id="_IDGenGridContainer1" snapToRow="true" items="{path: '/MonthlyData'}" class="sapUiSmallMargin">
        <f:items>
            <VBox id="_IDGenVBox5" class="sapUiTinyMargin">
                <layoutData>
                <f:GridContainerItemLayoutData id="_IDGenGridContainerData" minRows="1" columns="5" />
                </layoutData>
                <Title id="_IDGenTitle12" text="{Month}" />
                
                <Table id="_IDGenTable" items="{path: 'Commodities'}" class="cardTable">
                     
                    <columns>
                        <Column id="_IDGenColumn5"><Text id="_IDGenText21" text="Commodity"/></Column>
                        <Column id="_IDGenColumn6"><Text id="_IDGenText23" text="Purch | planned" wrapping="false"/></Column>
                        <Column id="_IDGenColumn7"><Text id="_IDGenText40" text="Sales | planned" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem1">
                            <cells>
                                <Text id="_IDGenText41" text="{Name}" />
                                <Text id="_IDGenText42" text="{Purch} | {p_planned}" />
                                <Text id="_IDGenText43" text="{Sales} | {s_planned}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:items>
    </f:GridContainer>

</Panel>
<Panel id="_IDGenPanel" class="sapUiSmallMargin">
<OverflowToolbar id="_IDGenOverflowToolbar1">
    <Title id="_IDGenTitle4" text="Deals ( )"  />
    
    <ToolbarSpacer id="_IDGenToolbarSpacer" />
             
    <Button id="_IDGenButton" text="Filters" icon="sap-icon://filter" />
    <Button id="_IDGenButton1" text="Create Deal" icon="sap-icon://add" type="Emphasized" />
    <Button id="_IDGenButton2" text="Edit Deal" icon="sap-icon://edit" />
    <SearchField id="_IDGenSearchField" placeholder="Search All Deals" width="15rem" />
</OverflowToolbar>
<VBox id="_IDGenVBox9">
<!-- Table Header section& Button -->
    <ScrollContainer id="_IDGenScrollContainer1" horizontal="true" vertical="true" width="100%">
    <Table id="tableid" mode="MultiSelect" items="{/Deals}" >
        <!-- Table Body  -->
        <columns>
            <Column id="_IDGenColumnT1" width="7rem">
                <header>
                    <Text id="_IDGenText8" text="Deal ID" />
                </header>
            </Column>
            <Column id="_IDGenColumnT2" width="7rem">
                <header>
                    <Text id="_IDGenText9" text="CounterParty" />
                </header>
            </Column>
            <Column id="_IDGenColumnTU2" width="7rem">
                <header>
                    <Text id="_IDGenTextU9" text="CounterParty Name" />
                </header>
            </Column>
            <Column id="_IDGenColumnT3" width="7rem">
                <header>
                    <Text id="_IDGenText10" text="Deal Type" />
                </header>
            </Column>
            <Column id="_IDGenColumnT4" width="7rem">
                <header>
                    <Text id="_IDGenText11" text="Commodity" />
                </header>
            </Column>
            <Column id="_IDGenColumnT5" width="7rem">
                <header>
                    <Text id="_IDGenText12" text="Status" />
                </header>
            </Column>
            <Column id="_IDGenColumnT6" width="7rem">
                <header>
                    <Text id="_IDGenText13" text="Trade Date" />
                </header>
            </Column>
            <Column id="_IDGenColumnTT7" width="7rem">
                <header>
                    <Text id="_IDGenText14" text="Valid From" />
                </header>
            </Column>
            <Column id="_IDGenColumnT7" width="7rem">
                <header>
                    <Text id="_IDGenText15" text="Valid To" />
                </header>
            </Column>
            <Column id="_IDGenColumnT8" width="7rem">
                <header>
                    <Text id="_IDGenText16" text="Schedule Date" />
                </header>
            </Column>
            <Column id="_IDGenColumnT9" width="7rem">
                <header>
                    <Text id="_IDGenText17" text="Schedule Quantity" />
                </header>
            </Column>
            <Column id="_IDGenColumnT10" width="7rem">
                <header>
                    <Text id="_IDGenText18" text="Called-of Quantity"/>
                </header>
            </Column>
            <Column id="_IDGenColumnT11" width="7rem">
                <header>
                    <Text id="_IDGenTextT19" text="Origin" />
                </header>
            </Column>
            <Column id="_IDGenColumnT12" width="7rem">
                <header>
                    <Text id="_IDGenTextT20" text="Origin ID" />
                </header>
            </Column>
            <Column id="_IDGenColumnT13" width="7rem">
                <header>
                    <Text id="_IDGenTextT21" text="Destination" />
                </header>
            </Column>
            <Column id="_IDGenColumnT14" width="7rem">
                <header>
                    <Text id="_IDGenTextT22" text="Destination ID" />
                </header>
            </Column>
            <Column id="_IDGenColumnT15" width="7rem">
                <header>
                    <Text id="_IDGenTextT23" text="MarketZone" />
                </header>
            </Column>
            <Column id="_IDGenColumnT16" width="7rem">
                <header>
                    <Text id="_IDGenText19" text="MarketZone ID" />
                </header>
            </Column>
            <Column id="_IDGenColumnT17" width="7rem">
                <header>
                    <Text id="_IDGenText20" text="MOT" />
                </header>
            </Column>
            <Column id="_IDGenColumnT19" width="7rem">
                <header>
                    <Text id="_IDGenText22" text="Pricing" />
                </header>
            </Column>
        </columns>
        <items>
        <ColumnListItem id="_IDGenColumnListItem3" type="Inactive">
            <cells>
                <Text id="_IDGenText44" text="{DealId}" />
                <Text id="_IDGenText45" text="{CounterParty}" />
                <Text id="_IDGenText46" text="{CounterPartyName}" />
                <Text id="_IDGenText47" text="{DealType}" />
                <Text id="_IDGenText48" text="{Commodity}" />
                <ObjectStatus id="_IDGenObjectStatus1" text="{Status}" state="{= ${Status} === 'Active' ? 'Success' : 'Warning'}" />
                <Text id="_IDGenText49" text="{TradeDate}" />
                <Text id="_IDGenText50" text="{ValidFrom}" />
                <Text id="_IDGenText51" text="{ValidTo}" />
                <Text id="_IDGenText52" text="{ScheduleDate}" />
                <Text id="_IDGenText53" text="{ScheduleQuantity}" />
                <Text id="_IDGenText54" text="{CalledOfQuantity}" />
                <Text id="_IDGenText55" text="{Origin}" />
                <Text id="_IDGenText56" text="{OriginId}" />
                <Text id="_IDGenText57" text="{Destination}" />
                <Text id="_IDGenText58" text="{DestinationId}" />
                <Text id="_IDGenText59" text="{MarketZone}" />
                <Text id="_IDGenText60" text="{MarketZoneId}" />
                <Text id="_IDGenText61" text="{MOT}" />
                <Text id="_IDGenText62" text="{Price}" />
            </cells>
        </ColumnListItem>
    </items>
    </Table>
    </ScrollContainer>
</VBox >
</Panel>
<HBox id="_IDGenVBox10" wrap="Wrap" class="sapUiContentPadding sapUiSmallMargin">
    <Panel id="_IDGenCard1" class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="14rem">
        <VBox id="_IDGenVBox11" class="sapUiSmallMargin">
            <HBox id="_IDGenHBox1" justifyContent="SpaceBetween" alignItems="Center">
                <Title id="_IDGenTitle5" text="Active Deals" level="H6" titleStyle="H6"/>
                <Avatar id="_IDGenAvatar" src="sap-icon://accept" displaySize="XS" displayShape="Square" class="sapFAvatarSuccess"/>
            </HBox>
            <NumericContent id="_IDGenNumericContent" value="247" indicator="Up" valueColor="Good"/>
            <Text id="_IDGenText24" text="+12%" class="sapUiTinyMarginTop"/>
        </VBox>
    </Panel>
    <Panel id="_IDGenCard3" class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="14rem">
        <VBox id="_IDGenVBox12" class="sapUiSmallMargin">
            <HBox id="_IDGenHBox3" justifyContent="SpaceBetween" alignItems="Center">
                <Title id="_IDGenTitle6" text="Pending Obligations" level="H6" titleStyle="H6"/>
                <Avatar id="_IDGenAvatar1" src="sap-icon://exclamation" displaySize="XS" displayShape="Square" class="sapFAvatarWarning"/>
            </HBox>
            <NumericContent id="_IDGenNumericContent1" value="58" indicator="Down" valueColor="Critical"/>
            <Text id="_IDGenText25" text="-5%" class="sapUiTinyMarginTop"/>
        </VBox>
    </Panel>
    <Panel id="_IDGenCard4" class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="14rem">
        <VBox id="_IDGenVBox13" class="sapUiSmallMargin">
            <HBox id="_IDGenHBox4" justifyContent="SpaceBetween" alignItems="Center">
                <Title id="_IDGenTitle7" text="Fulfilled Entitlements" level="H6" titleStyle="H6"/>
                <Avatar id="_IDGenAvatar3" src="sap-icon://accept" displaySize="XS" displayShape="Square" class="sapFAvatarSuccess"/>
            </HBox>
            <NumericContent id="_IDGenNumericContent3" value="1,842" indicator="Up" valueColor="Good"/>
            <Text id="_IDGenText26" text="+18%" class="sapUiTinyMarginTop"/>
        </VBox>
    </Panel>
    <Panel id="_IDGenCard5" class="sapUiSmallMarginEnd sapUiSmallMarginBottom" width="14rem">
        <VBox id="_IDGenVBox14" class="sapUiSmallMargin">
            <HBox id="_IDGenHBox5" justifyContent="SpaceBetween" alignItems="Center">
                <Title id="_IDGenTitle8" text="Total Volume" level="H6" titleStyle="H6"/>
                <Avatar id="_IDGenAvatar4" src="sap-icon://bar-chart" displaySize="XS" displayShape="Square" class="sapFAvatarSuccess"/>
            </HBox>
            <NumericContent id="_IDGenNumericContent4" value="12.4k" indicator="Up" valueColor="Good"/>
            <Text id="_IDGenText27" text="+8%" class="sapUiTinyMarginTop"/>
        </VBox>
    </Panel>
</HBox>


</core:FragmentDefinition>
