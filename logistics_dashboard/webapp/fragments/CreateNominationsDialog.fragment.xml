<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:table="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
>
    <Dialog
        id="dlgCreateNominations"
        title="{nomDialogModel>/DialogTitle}"
        contentWidth="1300px"
        contentHeight="85vh"
        resizable="true"
        draggable="true"
        class="nom-create-dialog"
        verticalScrolling="true"
        horizontalScrolling="false">
        <content>
            <FlexBox id="_IDGenFlexBox4"
                direction="Column"
                class="nom-dlg-container"
                fitContainer="true">
                <ScrollContainer id="_IDGenScrollContainer"
                    vertical="true"
                    horizontal="false"
                    focusable="true"
                    class="nom-scroll-container">
                    <FlexBox id="_IDGenFlexBox5"
                        direction="Column"
                        class="nom-dlg-wrapper">
                        <!-- ── Header strip ── -->
                        <FlexBox id="_IDGenFlexBox6"
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                            wrap="NoWrap"
                            class="nom-dlg-header-strip">
                            <FlexBox id="_IDGenFlexBox7"
                                alignItems="Center"
                                class="nom-dlg-header-field">
                                <Label id="_IDGenLabel"
                                    text="Commodity"
                                    design="Bold"
                                    class="nom-lbl-bold nom-lbl-fix"
                                />
                                <Text id="_IDGenText16"
                                    text="{nomDialogModel>/Commodity}"
                                    class="nom-plain-text"
                                />
                            </FlexBox>
                            <FlexBox id="_IDGenFlexBox8" id="_IDGenFlexBox9"
                                alignItems="Center"
                                class="nom-dlg-header-field"
                            >
                                <Label id="_IDGenLabel25"
                                    text="Week ID"
                                    design="Bold"
                                    class="nom-lbl-bold nom-lbl-fix"
                                />
                                <Text id="_IDGenText17"
                                    text="{nomDialogModel>/WeekID}"
                                    class="nom-plain-text"
                                />
                            </FlexBox>
                            <FlexBox id="_IDGenFlexBox9"
                                alignItems="Center"
                                class="nom-dlg-header-field"
                            >
                                <Label id="_IDGenLabel26"
                                    text="MoT"
                                    design="Bold"
                                    class="nom-lbl-bold nom-lbl-fix"
                                />
                                <Text id="_IDGenText127"
                                    text="{nomDialogModel>/ModeOfTransportLabel}"
                                    class="nom-plain-text"
                                />
                            </FlexBox>
                            <FlexBox id="_IDGenFlexBox10"
                                alignItems="Center"
                                class="nom-dlg-header-field"
                            >
                                <Label id="_IDGenLabel27"
                                    text="Schedule Date"
                                    design="Bold"
                                    class="nom-lbl-bold nom-lbl-fix"
                                />
                                <Text id="_IDGenText128"
                                    text="{= ${nomDialogModel>/PurchSchedDateDisplay} || ${nomDialogModel>/SalesSchedDateDisplay} }"
                                    class="nom-plain-text"
                                />
                            </FlexBox>
                            <FlexBox id="_IDGenFlexBox11"
                                alignItems="Center"
                                class="nom-dlg-header-field"
                            >
                                <Label id="_IDGenLabel28"
                                    text="Planned / Match Qty"
                                    design="Bold"
                                    class="nom-lbl-bold nom-lbl-fix"
                                />
                                <Text id="_IDGenText196"
                                    text="{nomDialogModel>/MatchQtyFormatted}"
                                    class="nom-plain-text"
                                />
                            </FlexBox>
                        </FlexBox>

                        <!-- ── Two tiles: Origin | Destination ── -->
                        <FlexBox id="_IDGenFlexBox12"
                            justifyContent="Center"
                            class="nom-tiles-row"
                        >
                            <!-- ORIGIN TILE -->
                            <Panel id="_IDGenPanel2"
                                headerText="Origin"
                                visible="{nomDialogModel>/ShowOriginPanel}"
                                expandable="false"
                                expanded="true"
                                class="nom-origin-panel nom-tile-panel"
                            >
                                <content>
                                    <FlexBox id="_IDGenFlexBox13"
                                        direction="Column"
                                        class="nom-tile-content"
                                    >
                                        <FlexBox id="_IDGenFlexBox14"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel29"
                                                text="Deal Number"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText197"
                                                text="{nomDialogModel>/OriginDealNumber}"
                                                class="nom-tile-value nom-tile-value-highlight nom-plain-text"
                                            />
                                        </FlexBox>
                                        <FlexBox id="_IDGenFlexBox15"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel30"
                                                text="Location / Origin"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText198"
                                                text="{nomDialogModel>/OriginLocation}"
                                                class="nom-tile-value nom-plain-text"
                                            />
                                        </FlexBox>
                                        <FlexBox id="_IDGenFlexBox16"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel31"
                                                text="Quantity"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText199"
                                                text="{nomDialogModel>/OriginQty}"
                                                class="nom-tile-value nom-plain-text"
                                            />
                                        </FlexBox>
                                        <FlexBox id="_IDGenFlexBox17"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel32"
                                                text="Planned / Match Quantity"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText200"
                                                text="{nomDialogModel>/MatchQtyFormatted}"
                                                class="nom-tile-value nom-plain-text"
                                            />
                                        </FlexBox>
                                        <FlexBox id="_IDGenFlexBox18"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel33"
                                                text="Delivery Date"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText201"
                                                text="{nomDialogModel>/PurchSchedDateDisplay}"
                                                class="nom-tile-value nom-plain-text"
                                            />
                                        </FlexBox>
                                        <FlexBox id="_IDGenFlexBox19"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel34"
                                                text="Supplier"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText202"
                                                text="{nomDialogModel>/OriginPartner}"
                                                class="nom-tile-value nom-plain-text"
                                            />
                                        </FlexBox>
                                    </FlexBox>
                                </content>
                            </Panel>

                            <!-- DESTINATION TILE -->
                            <Panel id="_IDGenPanel3"
                                headerText="Destination"
                                visible="{nomDialogModel>/ShowDestinationPanel}"
                                expandable="false"
                                expanded="true"
                                class="nom-destination-panel nom-tile-panel"
                            >
                                <content>
                                    <FlexBox id="_IDGenFlexBox20"
                                        direction="Column"
                                        class="nom-tile-content"
                                    >
                                        <FlexBox id="_IDGenFlexBox21"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel35"
                                                text="Deal Number"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText203"
                                                text="{nomDialogModel>/DestinationDealNumber}"
                                                class="nom-tile-value nom-tile-value-highlight nom-plain-text"
                                            />
                                        </FlexBox>
                                        <FlexBox id="_IDGenFlexBox22"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel36"
                                                text="Location / Destination"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText204"
                                                text="{nomDialogModel>/DestinationLocation}"
                                                class="nom-tile-value nom-plain-text"
                                            />
                                        </FlexBox>
                                        <FlexBox id="_IDGenFlexBox23"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel37"
                                                text="Quantity"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText205"
                                                text="{nomDialogModel>/DestinationQty}"
                                                class="nom-tile-value nom-plain-text"
                                            />
                                        </FlexBox>
                                        <FlexBox id="_IDGenFlexBox24"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel38"
                                                text="Planned / Match Quantity"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText206"
                                                text="{nomDialogModel>/MatchQtyFormatted}"
                                                class="nom-tile-value nom-plain-text"
                                            />
                                        </FlexBox>
                                        <FlexBox id="_IDGenFlexBox25"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel39"
                                                text="Due Date"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText207"
                                                text="{nomDialogModel>/SalesSchedDateDisplay}"
                                                class="nom-tile-value nom-plain-text"
                                            />
                                        </FlexBox>
                                        <FlexBox id="_IDGenFlexBox26"
                                            alignItems="Center"
                                            class="nom-tile-row"
                                        >
                                            <Label id="_IDGenLabel40"
                                                text="Customer"
                                                class="nom-tile-label nom-lbl-fix"
                                            />
                                            <Text id="_IDGenText208"
                                                text="{nomDialogModel>/DestinationPartner}"
                                                class="nom-tile-value nom-plain-text"
                                            />
                                        </FlexBox>
                                    </FlexBox>
                                </content>
                            </Panel>
                        </FlexBox>

                        <!-- ── Editable controls row (Match Qty + No of Nominations only) ── -->
                        <FlexBox id="_IDGenFlexBox27"
                            alignItems="End"
                            justifyContent="Center"
                            wrap="Wrap"
                            class="nom-ctrl-row"
                        >
                            <!-- Match Qty -->
                            <FlexBox id="_IDGenFlexBox28"
                                direction="Column"
                                alignItems="Center"
                                class="nom-ctrl-cell"
                            >
                                <Label id="_IDGenLabel41"
                                    text="Match Qty"
                                    design="Bold"
                                    class="nom-ctrl-label nom-lbl-fix"
                                />
                                <Input
                                    id="dlgEditMatchQty"
                                    value="{nomDialogModel>/EditMatchQty}"
                                    width="140px"
                                    textAlign="Right"
                                    change="onNomMatchQtyChange"
                                    class="nom-editable-input"
                                    placeholder="0"
                                />
                            </FlexBox>

                            <!-- No of Nominations -->
                            <FlexBox id="_IDGenFlexBox29"
                                direction="Column"
                                alignItems="Center"
                                class="nom-ctrl-cell"
                            >
                                <Label id="_IDGenLabel42"
                                    text="No of Nominations"
                                    design="Bold"
                                    class="nom-ctrl-label nom-lbl-fix"
                                />
                                <StepInput
                                    id="dlgNoOfRows"
                                    value="{nomDialogModel>/NoOfRows}"
                                    min="1"
                                    max="50"
                                    step="1"
                                    width="140px"
                                    change="onNomNoOfRowsChange"
                                    class="nom-editable-input"
                                />
                            </FlexBox>
                        </FlexBox>

                        <!-- ── Schedule Table ── -->
                        <table:Table
                            id="nomScheduleTable"
                            rows="{nomDialogModel>/scheduleRows}"
                            alternateRowColors="false"
                            selectionMode="None"
                            class="nom-schedule-table"
                            width="100%"
                            noData="No rows added. Increase 'No of Nominations' to add rows."
                        >
                            <table:rowMode>
                                <rowmodes:Auto id="_IDGenAuto" />
                            </table:rowMode>
                            <table:columns>
                                <!-- Schedule Date -->
                                <table:Column id="_IDGenColumn20"
                                    width="10rem"
                                    hAlign="Center"
                                >
                                    <table:label>
                                        <Label id="_IDGenLabel43" text="Schedule Date" />
                                    </table:label>
                                    <table:template>
                                        <DatePicker id="_IDGenDatePicker"
                                            value="{nomDialogModel>ScheduleDate}"
                                            displayFormat="M/d/yyyy"
                                            valueFormat="yyyy-MM-dd"
                                            width="9rem"
                                        />
                                    </table:template>
                                </table:Column>

                                <!-- Schedule Qty -->
                                <table:Column id="_IDGenColumn21"
                                    width="10rem"
                                    hAlign="End"
                                >
                                    <table:label>
                                        <Label id="_IDGenLabel44" text="Schedule Qty" />
                                    </table:label>
                                    <table:template>
                                        <Input id="_IDGenInput1"
                                            value="{nomDialogModel>ScheduleQty}"
                                            textAlign="Right"
                                            placeholder="0"
                                            width="9rem"
                                            change="onNomRowQtyChange"
                                            class="nom-editable-input"
                                        />
                                    </table:template>
                                </table:Column>

                                <!-- MoT -->
                                <table:Column id="_IDGenColumn39" width="9rem">
                                    <table:label>
                                        <Label id="_IDGenLabel45" text="MoT" />
                                    </table:label>
                                    <table:template>
                                        <Select id="_IDGenSelect2"
                                            selectedKey="{nomDialogModel>MoT}"
                                            width="8rem"
                                            items="{path: 'nomMOTModel>/options'}"
                                            change="onNomRowMoTChange"
                                        >
                                            <core:Item id="_IDGenItem"
                                                key="{nomMOTModel>key}"
                                                text="{nomMOTModel>text}"
                                            />
                                        </Select>
                                    </table:template>
                                </table:Column>

                                <!-- Carrier -->
                                <table:Column id="_IDGenColumn51" width="14rem">
                                    <table:label>
                                        <Label id="_IDGenLabel46" text="Carrier" />
                                    </table:label>
                                    <table:template>
                                        <Input id="_IDGenInput2"
                                            value="{nomDialogModel>CarrierCode}"
                                            placeholder="F4 to search carrier..."
                                            width="13rem"
                                            showValueHelp="true"
                                            valueHelpRequest="onCarrierValueHelp"
                                            class="nom-editable-input"
                                        />
                                    </table:template>
                                </table:Column>

                                <!-- Shipper -->
                                <table:Column id="_IDGenColumn52" width="14rem">
                                    <table:label>
                                        <Label id="_IDGenLabel47" text="Shipper" />
                                    </table:label>
                                    <table:template>
                                        <Input id="_IDGenInput3"
                                            value="{nomDialogModel>ShipperCode}"
                                            placeholder="F4 to search Shipper..."
                                            width="13rem"
                                            showValueHelp="true"
                                            valueHelpRequest="onShipperValueHelp"
                                            class="nom-editable-input"
                                        />
                                    </table:template>
                                </table:Column>

                                <!-- Vehicle ID -->
                                <table:Column id="_IDGenColumn53" width="14rem">
                                    <table:label>
                                        <Label id="_IDGenLabel48" text="Vehicle ID" />
                                    </table:label>
                                    <table:template>
                                        <Input id="_IDGenInput4"
                                            value="{nomDialogModel>VehicleId}"
                                            placeholder="F4 to search vehicle..."
                                            width="13rem"
                                            showValueHelp="true"
                                            valueHelpRequest="onVehicleValueHelp"
                                            class="nom-editable-input"
                                        />
                                    </table:template>
                                </table:Column>

                                <!-- Delete -->
                                <table:Column id="_IDGenColumn54"
                                    width="4rem"
                                    hAlign="Center"
                                >
                                    <table:label>
                                        <Label id="_IDGenLabel49" text="" />
                                    </table:label>
                                    <table:template>
                                        <Button id="_IDGenButton1"
                                            icon="sap-icon://delete"
                                            tooltip="Remove this row"
                                            press="onRemoveNominationRow"
                                            type="Transparent"
                                        />
                                    </table:template>
                                </table:Column>
                            </table:columns>
                        </table:Table>
                    </FlexBox>
                </ScrollContainer>
            </FlexBox>
        </content>
        <beginButton>
            <Button id="_IDGenButton2"
                text="Confirm Nomination(s)"
                type="Emphasized"
                icon="sap-icon://accept"
                press="onNomDialogSubmit"
            />
        </beginButton>
        <endButton>
            <Button id="_IDGenButton3"
                text="Cancel"
                type="Transparent"
                press="onNomDialogCancel"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
