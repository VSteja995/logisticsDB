<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:table="sap.ui.table">

    <!-- ═══════════════════════════════════════════════════════
         PANEL 1 : Filters + KPI Summary Cards
         ═══════════════════════════════════════════════════════ -->

     <Panel id="_IDGenPanel1"  headerText="KPI Summary Cards" class="sapUiTinyMargin" expanded="true" expandable="true" >
        <!-- KPI Cards -->
        <HBox id="kpiBox" wrap="Wrap">
            <VBox id="entCard" class="kpiCard green-border sapUiSmallMarginEnd">
                <Text id="entLbl" text="Total Entitlements" class="kpiLabel"/>
                <Title id="entVal" text="2,40,000" class="kpiValue"/>
                <Text id="entSub" text="6 positions" class="kpiSubtext"/>
                
                <core:Icon id="entIcon" size="25px" src="sap-icon://trend-up"  color="#2b7d2b"/>
            </VBox>
            <VBox id="oblCard" class="kpiCard red-border sapUiSmallMarginEnd">
                <Text id="oblLbl" text="Total Obligations" class="kpiLabel"/>
                <Title id="oblVal" text="2,02,000" class="kpiValue"/>
                <Text id="oblSub" text="6 positions" class="kpiSubtext"/>
                <core:Icon id="oblIcon" size="25px" src="sap-icon://trend-down"  color="#fb0404"/>
            </VBox>
            <VBox id="planCard" class="kpiCard blue-border sapUiSmallMarginEnd">
                <Text id="planLbl" text="Total Planned" class="kpiLabel"/>
                <Title id="planVal" text="2,02,000" class="kpiValue"/>
                <Text id="planSub" text="6 positions" class="kpiSubtext"/>
                <core:Icon id="planIcon" size="25px" src="sap-icon://select-appointments"  color="#048ef7"/>
            </VBox>
            <VBox id="netCard" class="kpiCard green-border sapUiSmallMarginEnd">
                <Text id="netLbl" text="Net Position" class="kpiLabel"/>
                <Title id="netVal" text="2,02,000" class="kpiValue"/>
                <Text id="netSub" text="6 positions" class="kpiSubtext"/>
               
            </VBox>
        </HBox>
    </Panel>


    <Panel id="sumPanel" class="sapUiTinyMargin" headerText="Planning Summary" expandable="true" expanded="true" >

        <!-- Filter Row -->
        <HBox id="fBox" alignItems="Center" justifyContent="SpaceBetween"
              class="filterContainer sapUiSmallMargin">
           
            <Label id="dtLbl" text="DateRange :"/>
            <DateRangeSelection id="dateDrs" placeholder="MM/DD/YYYY - MM/DD/YYYY" change=".onPosDateRangeChange"/>
            <Label id="modeLbl" text="Mode :"/>
            <SegmentedButton id="modeSeg" selectedKey="All" selectionChange=".onPosModeChange">
                <items>
                    <SegmentedButtonItem id="allPosSeg" key="All" text="All" icon="sap-icon://multiselect-all"/>
                    <SegmentedButtonItem id="truckPosSeg" key="Truck" text="Truck" icon="sap-icon://shipping-status"/>
                    <SegmentedButtonItem id="trainPosSeg" key="Train" text="Rail" icon="sap-icon://cargo-train"/>
                </items>
            </SegmentedButton>
            <Label id="commLbl" text="Commodity :"/>
            <MultiComboBox id="commBox" placeholder="Select Commodity" width="100%" selectionChange=".onPosCommoditySelectionFinish" selectionFinish=".onPosCommoditySelectionFinish" items="{UniqDealCmdtyData>/UniqDealCmdtySet}">
                <items>
                    <core:Item id="gas87Item" key="{UniqDealCmdtyData>Commodity}" text="{UniqDealCmdtyData>Commodity}"/>
                     <!-- <core:Item id="DlPnl1Ite013" key="SOYBNOIL" text="SOYBNOIL"/> -->
                     <!-- <core:Item id="DlPnl1Ite014" key="CRUACCE01" text="CRUACCE01"/> -->
                </items>
            </MultiComboBox>
            <!-- <Label id="zoneLbl" text="Market Zone :"/>
            <MultiComboBox id="zoneBox" placeholder="All Zones" width="100%">
                <items>
                    <core:Item id="zone87Item" key="GAS87" text="GAS87"/>
                    <core:Item id="zone88Item" key="GAS88" text="GAS88"/>
                </items>
            </MultiComboBox> -->
        </HBox>
    </Panel>
   
   
         PANEL 2 : Planning Summary by UOM (Summary Table)

    <Panel id="uomPanel"  headerText="Planning Summary by UOM" class="sapUiTinyMargin" expandable="true" expanded="true" >
        <Table id="uomTbl" fixedLayout="false" inset="false" class="TableContainer sapUiSmallMargin" width="100%" items="{TotalSummaryData>/TotalSummarySet}">
            <columns>
                <Column id="uomColCom"><Text id="uomComTxt" text="Commodity"/></Column>
                <Column id="uomColUnit"><Text id="uomUnitTxt" text="Base Unit"/></Column>
                <Column id="uomColEnt"><Text id="uomEntTxt" text="Total Entitlements (Long)"/></Column>
                <Column id="uomColObl"><Text id="uomOblTxt" text="Total Obligations (Short)"/></Column>
                <Column id="uomColMatch"><Text id="uomMatchTxt" text="Total Matched"/></Column>
                <!-- <Column id="uomColNet"><Text id="uomNetTxt" text="Net Position"/></Column>
                <Column id="uomColStatus"><Text id="uomStatusTxt" text="Status"/></Column> -->
            </columns>
            <items>
                <ColumnListItem id="uomRow">
                    <cells>
                       <Text id="uomComT0" text="{TotalSummaryData>Commodity}"/>
                       <Text id="uomUnitT1" text="{TotalSummaryData>UOM}"/>
                       <Text id="uomEntT2" text="{TotalSummaryData>TotalEntitlements}"/>
                       <Text id="uomOblT3" text="{TotalSummaryData>TotalObligations}"/>
                       <Text id="uomMatchT4" text="{TotalSummaryData>TotalMatched}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Panel>

    
         PANEL 3 : Planning Details (4-quadrant split view)
   
