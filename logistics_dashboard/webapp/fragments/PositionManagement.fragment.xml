                        showRowCount="true"
                        enableAutoBinding="false"
                        enableCopy="false"
                        editable="false"
                        showFullScreenButton="false" >

                        <ScrollContainer id="oblScroll" horizontal="true" vertical="true" width="100%" height="100%" >
                    <Table id="oblTbl" fixedLayout="false" items="{OblDetailData>/OblDetailSet}" mode="MultiSelect" >
                        <columns>
                            <Column id="_IDGenColumn22"><header><Text id="_IDGenText21" text="Deal ID"/></header></Column>
                            <Column id="_IDGenColumn23"><header><Text id="_IDGenText22" text="Commodity"/></header></Column>
                            <Column id="_IDGenColumn24"><header><Text id="_IDGenText23" text="Sales Document"/></header></Column>
                            <Column id="_IDGenColumn25"><header><Text id="_IDGenText24" text="Sales Item"/></header></Column>
                            <Column id="_IDGenColumn26"><header><Text id="_IDGenText25" text="Sales Quantity"/></header></Column>
                            <Column id="_IDGenColumn27"><header><Text id="_IDGenText26" text="Match Qunatity"/></header></Column>
                            <Column id="_IDGenColumn28"><header><Text id="_IDGenText27" text="Due Date"/></header></Column>
                            <Column id="_IDGenColumn29"><header><Text id="_IDGenText28" text="Due month"/></header></Column>
                            <Column id="_IDGenColumn30"><header><Text id="_IDGenText29" text="Transaction Type"/></header></Column>
                            <Column id="_IDGenColumn31"><header><Text id="_IDGenText30" text="Week ID"/></header></Column>
                            <Column id="_IDGenColumn32"><header><Text id="_IDGenText31" text="Customer "/></header></Column>
