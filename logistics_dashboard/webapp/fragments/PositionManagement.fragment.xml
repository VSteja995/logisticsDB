            </VBox>

            <!-- Selected Items section -->
            <VBox id="selBox" class="splitterSection">
                <layoutData>
                    <layout:SplitterLayoutData id="selLay" size="50%"/>
                </layoutData>
<Toolbar id="selBar" class="splitterSectionHeader">
    <Title id="selTitle" text="Selected Items" level="H4"/>
    <ToolbarSpacer id="selSpc" />
    <Button id="crtmthntn" text="Create Match" icon="sap-icon://add" type="Emphasized" press="onCreateMatch"/>
    <Button id="confirmMatchBtn" text="Confirm Match" icon="sap-icon://accept" type="Accept" press=".onConfirmMatch"/> 
    <Button id="clearSelBtn" text="Clear All" icon="sap-icon://decline" type="Ghost" press=".onClearAllSelections"/>   
    <Button id="selFullBtnSE" press="onFullScreenToggle" icon="sap-icon://full-screen" type="Transparent"/>
</Toolbar>
                <ScrollContainer id="selScroll" horizontal="true" vertical="true" width="100%" height="100%">
                <table:TreeTable id="matchedTable" rows="{path: 'matchedPositionsModel>/results', parameters: {arrayNames: ['children']}}" selectionMode="None" alternateRowColors="true" noData="No staged matches yet — select rows from 2+ tables, then click 'Create Match'." class="pos-matched-grid-table" width="100%">
            <table:columns>
                <!-- Col 1: Check / Warning -->
                                <table:Column id="colCheck" width="6rem" hAlign="Center">
                    <Label id="_IDGenLabel1" text="✓ / ⚠"/>
                    <table:template>
                        <FlexBox id="_IDGenFlexBox" alignItems="Center" justifyContent="Center" class="pos-check-cell">
                            <core:Icon id="_IDGenIcon" src="sap-icon://warning" color="{= ${matchedPositionsModel>_validationSeverity} === 'Error' ? '#BB0000' : '#E9730C' }" visible="{= !!${matchedPositionsModel>_validationMsg} }" tooltip="{matchedPositionsModel>_validationMsg}" class="pos-validation-icon sapUiTinyMarginBegin"/>
                            <CheckBox id="_IDGenCheckBox" selected="{matchedPositionsModel>_checked}" partiallySelected="{matchedPositionsModel>_partiallyChecked}" select="onMatchCheckChange" tooltip="Include / exclude this row from Confirm Match"/>
                        </FlexBox>
                    </table:template>
                </table:Column>
                <!-- Col 2: Deal ID -->
                <table:Column id="colNodeLabel" width="13rem">
                    <Label id="_IDGenLabel2" text="Deal ID"/>
                    <table:template>
                        <Text id="_IDGenText37" text="{matchedPositionsModel>NodeLabel}" wrapping="false" tooltip="{matchedPositionsModel>NodeLabel}" class="{= ${matchedPositionsModel>RowType} === 'parent' ? 'pos-tree-parent-label' : 'pos-tree-child-label'}"/>
                    </table:template>
                </table:Column>
                <!-- Col 3: Document Number -->
                <table:Column id="colDisplayDoc" width="6rem">
                    <Label id="_IDGenLabel3" text="Doc No."/>
                    <table:template>
                        <Text id="_IDGenText38" text="{matchedPositionsModel>DocumentNumber}" wrapping="false" tooltip="{matchedPositionsModel>DocumentNumber}"/>
                    </table:template>
                </table:Column>
                <!-- Col 4: Doc Item -->
                <table:Column id="colDisplayDocItem" width="5rem" hAlign="Center">
                    <Label id="_IDGenLabel4" text="Doc Item"/>
                    <table:template>
                        <Text id="_IDGenText50" text="{matchedPositionsModel>DocumentItem}" wrapping="false"/>
                    </table:template>
                </table:Column>
                <!-- Col 5: Commodity -->
                <table:Column id="colTreeCommodity" width="6rem" hAlign="Center">
                    <Label id="_IDGenLabel5" text="Commodity"/>
                    <table:template>
                        <Text id="_IDGenText51" text="{matchedPositionsModel>Commodity}" wrapping="false"/>
                    </table:template>
                </table:Column>
                <!-- Col 6: Quantity -->
                <table:Column id="colDisplayQty" width="6rem">
                    <Label id="_IDGenLabel6" text="Quantity"/>
                    <table:template>
                        <Text id="_IDGenText52" text="{matchedPositionsModel>DisplayQty}" wrapping="false" class="{= ${matchedPositionsModel>RowType} === 'parent' ? 'pos-table-green' : 'pos-table-blue'}"/>
                    </table:template>
                </table:Column>
                <!-- Col 7: UOM -->
                <table:Column id="colDisplayUOM" width="4rem">
                    <Label id="_IDGenLabel7" text="UOM"/>
                    <table:template>
                        <Text id="_IDGenText53" text="{matchedPositionsModel>DisplayUOM}" wrapping="false"/>
                    </table:template>
                </table:Column>
                <!-- Col 8: Transaction Type -->
                <table:Column id="colTransactionType" width="4rem" hAlign="Center">
                    <Label id="_IDGenLabel8" text="Tx Type"/>
                    <table:template>
                        <ObjectStatus id="_IDGenObjectStatus" text="{matchedPositionsModel>TransactionType}" state="{= ${matchedPositionsModel>TransactionType} === 'P' ? 'Success' : ${matchedPositionsModel>TransactionType} === 'S' ? 'Warning' : 'None' }" tooltip="{= ${matchedPositionsModel>TransactionType} === 'P' ? 'Purchase' : ${matchedPositionsModel>TransactionType} === 'S' ? 'Sales' : '' }"/>
                    </table:template>
                </table:Column>
                <!-- Col 9: Incoterms -->
                <table:Column id="colIncoterms" width="5rem" hAlign="Center">
                    <Label id="_IDGenLabel9" text="Incoterms"/>
                    <table:template>
                        <Text id="_IDGenText54" text="{matchedPositionsModel>Incoterms}" wrapping="false"/>
                    </table:template>
                </table:Column>
                <table:Column id="colScheduleType" width="5rem" hAlign="Center">
                    <Label id="_IDGenLabel10" text="Schedule Type"/>
                    <table:template>
                        <Text id="_IDGenText55" text="{matchedPositionsModel>ScheduleType}" wrapping="false"/>
                    </table:template>
                </table:Column>
                <table:Column id="colRefDocType" width="5rem" hAlign="Center">
                    <Label id="_IDGenLabel11" text="Ref Doc Type"/>
                    <table:template>
                        <Text id="_IDGenText56" text="{matchedPositionsModel>RefDocType}" wrapping="false"/>
                    </table:template>
                </table:Column>
                <!-- Col 10: Mode of Transport -->
                <table:Column id="colModeOfTransport" width="8rem" hAlign="Center">
                    <Label id="_IDGenLabel12" text="Mode of Transport"/>
                    <table:template>
                        <FlexBox id="_IDGenFlexBox1" alignItems="Center">
                            <Text id="_IDGenText57" text="{matchedPositionsModel>ModeOfTransportLabel}" wrapping="false" visible="{= ${matchedPositionsModel>RowType} === 'parent'}"/>
                            <Select id="_IDGenSelect" selectedKey="{matchedPositionsModel>_selectedMoT}" visible="{= ${matchedPositionsModel>RowType} === 'child' &amp;&amp; ${matchedPositionsModel>_motConflict} === true}" change="onMoTSelectionChange" width="8rem" items="{path: 'matchedPositionsModel>_motOptions', templateShareable: false}">
                                <core:Item id="_IDGenItem1" key="{matchedPositionsModel>key}" text="{matchedPositionsModel>text}"/>
                            </Select>
                            <Text id="_IDGenText58" text="{matchedPositionsModel>ModeOfTransportLabel}" wrapping="false" visible="{= ${matchedPositionsModel>RowType} === 'child' &amp;&amp; ${matchedPositionsModel>_motConflict} !== true}"/>
                        </FlexBox>
                    </table:template>
                </table:Column>
                <!-- Col 11: Delivery / Due Date -->
                <table:Column id="colDisplayDate" width="8rem" hAlign="Center">
                    <Label id="_IDGenLabel13" text="Delivery/Due Date"/>
                    <table:template>
                        <Text id="_IDGenText59" text="{matchedPositionsModel>DisplayDate}" wrapping="false"/>
                    </table:template>
                </table:Column>
                <!-- Col 12: Month -->
                <table:Column id="colDisplayMonth" width="4rem" hAlign="Center">
                    <Label id="_IDGenLabel14" text="Month"/>
                    <table:template>
                        <Text id="_IDGenText60" text="{matchedPositionsModel>DisplayMonth}" wrapping="false"/>
                    </table:template>
                </table:Column>
                <!-- Col 13: Supplier / Customer -->
                <table:Column id="colDisplayParty" width="14rem" hAlign="Center">
                    <Label id="_IDGenLabel15" text="Supplier/Customer"/>
                    <table:template>
                        <Text id="_IDGenText61" text="{matchedPositionsModel>DisplayParty}" wrapping="false"/>
                    </table:template>
                </table:Column>
                <!-- Col 14: Origin -->
                <table:Column id="colOrigin" width="6rem" hAlign="Center">
                    <Label id="_IDGenLabel16" text="Origin"/>
                    <table:template>
                        <Text id="_IDGenText62" text="{matchedPositionsModel>Origin}" wrapping="false" tooltip="{matchedPositionsModel>OriginName}"/>
                    </table:template>
                </table:Column>
                <!-- Col 15: Destination -->
                <table:Column id="colDestination" width="6rem" hAlign="Center">
                    <Label id="_IDGenLabel17" text="Destination"/>
                    <table:template>
                        <Text id="_IDGenText63" text="{matchedPositionsModel>Destination}" wrapping="false" tooltip="{matchedPositionsModel>DestinationName}"/>
                    </table:template>
                </table:Column>
                <!-- Col 16: Week (Plan) with conflict toggle -->
                <table:Column id="colDisplayWeekID" width="6rem" hAlign="Center">
                    <Label id="_IDGenLabel18" text="Week (Plan)"/>
                    <table:template>
                        <FlexBox id="_IDGenFlexBox2" alignItems="Center">
                            <Text id="_IDGenText64" text="{matchedPositionsModel>DisplayWeekID}" wrapping="false" visible="{= !${matchedPositionsModel>_weekConflict} }"/>
                            <Select id="_IDGenSelect1" selectedKey="{matchedPositionsModel>_selectedWeekID}" visible="{= !!${matchedPositionsModel>_weekConflict} &amp;&amp; ${matchedPositionsModel>RowType} === 'child' }" change="onWeekIDSelectionChange" width="10rem" tooltip="Select delivery week for this planned match">
                                <core:Item id="_IDGenItem2" key="{matchedPositionsModel>_srcWeekID}" text="{matchedPositionsModel>_srcWeekID}"/>
                                <core:Item id="_IDGenItem3" key="{matchedPositionsModel>_tgtWeekID}" text="{matchedPositionsModel>_tgtWeekID}"/>
                            </Select>
                        </FlexBox>
                    </table:template>
                </table:Column>
                <!-- Col 17: Planned Quantity (editable on child) -->
                <table:Column id="colTreeMatchedQty" width="11rem" hAlign="End">
                    <Label id="_IDGenLabel19" text="Planned Quantity"/>
                    <table:template>
                        <FlexBox id="_IDGenFlexBox3" justifyContent="End" width="100%">
                            <Text id="_IDGenText65" text="{matchedPositionsModel>MatchedQtyFormatted}" wrapping="false" class="pos-table-blue" visible="{= ${matchedPositionsModel>RowType} === 'parent'}"/>
                            <Input id="_IDGenInput" value="{ path: 'matchedPositionsModel>MatchedQty', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 0, maxFractionDigits: 3 } }" width="9rem" textAlign="Right" visible="{= ${matchedPositionsModel>RowType} === 'child'}" change="onMatchedQtyChange" tooltip="Edit matched quantity"/>
                        </FlexBox>
                    </table:template>
                </table:Column>
                <!-- Col 18: Planned UOM -->
                <table:Column id="colTreeMatchedUOM" width="6rem">
                    <Label id="_IDGenLabel20" text="Planned UOM"/>
                    <table:template>
                        <Text id="_IDGenText66" text="{matchedPositionsModel>MatchedUOM}" wrapping="false"/>
                    </table:template>
                </table:Column>
                <!-- Col 19: Source -->
                <table:Column id="colTreeMatchSrc" width="5rem" hAlign="Center">
                    <Label id="_IDGenLabel21" text="Source"/>
                    <table:template>
                        <ObjectStatus id="_IDGenObjectStatus1" text="{matchedPositionsModel>MatchSrc}" state="Information"/>
                    </table:template>
                </table:Column>
                <!-- Col 20: Status -->
                <table:Column id="colTreeMatchStatus" width="6rem" hAlign="Center">
                    <Label id="_IDGenLabel22" text="Status"/>
                    <table:template>
                        <ObjectStatus id="_IDGenObjectStatus2" text="{matchedPositionsModel>Status}" state="{= ${matchedPositionsModel>Status} === 'Pending' ? 'Warning' : ${matchedPositionsModel>Status} === 'Confirmed' ? 'Success' : ${matchedPositionsModel>Status} === 'Warning' ? 'Warning' : ${matchedPositionsModel>Status} === 'Failed' ? 'Error' : ${matchedPositionsModel>Status} === 'Blocked' ? 'Error' : 'None' }"/>
                    </table:template>
                </table:Column>
                <!-- Col 21: Delete -->
                <table:Column id="colDelete" width="4rem" hAlign="Center">
                    <Label id="_IDGenLabel23" text="Delete"/>
                    <table:template>
                        <Button id="_IDGenButton" icon="sap-icon://delete" tooltip="Delete this match" press="onDeleteMatchedRow" type="Transparent" class="sapUiTinyMargin"/>
                    </table:template>
                </table:Column>
            </table:columns>
        </table:TreeTable>
                </ScrollContainer> 
            </VBox>

        </layout:Splitter>
     </layout:Splitter>
    </Panel>
