        <OverflowToolbar id="planBar">
            <Title id="idpdt"  text="Planning Detail"></Title>
         
            <ToolbarSpacer id="planSpc"/>
            
            <Button id="refreshPlanBtn" text="Refresh" icon="sap-icon://refresh" type="Ghost"  press=".onPlanningDetailRefresh"/>
        </OverflowToolbar>
        </headerToolbar>

        <!-- ROW 1 : Entitlements | Obligations -->
