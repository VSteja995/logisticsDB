                            <Column id="_IDGenColumn39"><header><Text id="_IDGenText38" text="MarketZone"/></header></Column>
                            <Column id="_IDGenColumn40"><header><Text id="_IDGenText39" text="MOT"/></header></Column>
                            <Column id="_IDGenColumn41"><header><Text id="_IDGenText40" text="Mode of transportation"/></header></Column>
                            <Column id="_IDGenColumn42"><header><Text id="_IDGenText41" text="Inco Terms"/></header></Column>

                        </columns>
                        <items>
                            <ColumnListItem id="123b" >
                                <cells>
                               
                                     <Text id="_IDGenText133" text="{OblDetailData>DealNumber}"></Text>
                                     <Text id="_IDGenText134" text="{OblDetailData>CommodityDesc}"></Text>
                                     <Text id="_IDGenText135" text="{OblDetailData>DocumentNumber}"></Text>
                                     <Text id="_IDGenText136" text="{OblDetailData>DocumentItem}"></Text>
                                     <Text id="_IDGenText137" text="{OblDetailData>SalesQuantity}"></Text>
                                     <Text id="_IDGenText138" text="{OblDetailData>MatchQuantity}"></Text>
                                     <Text id="_IDGenText139" text="{OblDetailData>DueDate}"></Text>
                                     <Text id="_IDGenText140" text="{OblDetailData>ScheduleMonth}"></Text>
                                     <Text id="_IDGenText141" text="{OblDetailData>TransactionType}"></Text>
                                     <Text id="_IDGenText142" text="{OblDetailData>Origin}"></Text>
                                  
                                    
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    </ScrollContainer>
                    </smartTable:SmartTable>
                
            </VBox>

        </layout:Splitter>

        <!-- ROW 2 : Inventory | Selected Items -->
        <layout:Splitter id="botSplit" orientation="Horizontal" >

            <!-- Inventory section -->
            <VBox id="invBox" class="splitterSection">
                <layoutData>
                    <layout:SplitterLayoutData id="invLay" size="50%"/>
                </layoutData>
                <Toolbar id="invBar" class="splitterSectionHeader">
                    <Title id="invTitle" text="Inventory" level="H4"/>
                    <ToolbarSpacer id="invSpc" ></ToolbarSpacer>
                   
                    <MenuButton id="_IDGenMenuButton3" icon="sap-icon://excel-attachment" type="Transparent">
                        <menu>
                            <Menu id="_IDGenMenu2">
                                <MenuItem id="_IDGenMenuItem4" text="Export" press=".onExport"/>
                                <MenuItem id="_IDGenMenuItem5" text="Export As." press=".onExportAs"/>
                            </Menu>
                        </menu>
                    </MenuButton>
                    <Button id="entFullBtnI" press="onFullScreenToggle" icon="sap-icon://full-screen" type="Transparent"/>
                    
                </Toolbar>
                <ScrollContainer id="invScroll" horizontal="true" vertical="true" width="100%" height="100%">
                    <Table id="invTbl" fixedLayout="false" items="{/InvDetails}">
                        <columns>
                            <Column id="_IDGenColumn43"><header><Text id="_IDGenText42" text="Commodity"/></header></Column>
                            <Column id="_IDGenColumn44"><header><Text id="_IDGenText43" text=" Plant"/></header></Column>
                            <Column id="_IDGenColumn45"><header><Text id="_IDGenText44" text="Storage location"/></header></Column>
                            <Column id="_IDGenColumn46"><header><Text id="_IDGenText45" text="Bussiness Location Id"/></header></Column>
