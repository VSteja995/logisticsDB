                                     <Text id="_IDGenText135" text="{OblDetailData>DocumentNumber}"></Text>
                                     <Text id="_IDGenText136" text="{OblDetailData>DocumentItem}"></Text>
                                     <Text id="_IDGenText137" text="{OblDetailData>SalesQuantity}"></Text>
                                     <Text id="_IDGenText138" text="{OblDetailData>MatchQuantity}"></Text>
                                     <Text id="_IDGenText139" text="{
                                     path :'OblDetailData>DueDate',
                                     type :'sap.ui.model.type.Date',
                                     formatOptions :{
                                          pattern :'YYYY/MMM/dd'
                                     }
                                     }"></Text>
                                     <Text id="_IDGenText140" text="{OblDetailData>ScheduleMonth}"></Text>
                                     <Text id="_IDGenText141" text="{OblDetailData>TransactionType}"></Text>
                                     <Text id="_IDGenText141E" text="{OblDetailData>WeekID}"></Text>
                                     <Text id="_IDGenText141F" text="{OblDetailData>Customer}"></Text>
                                     <Text id="_IDGenText141G" text="{OblDetailData>CustomerID}"></Text>
                                     <Text id="_IDGenText142" text="{OblDetailData>Origin}"></Text>
                                     <Text id="_IDGenText143"  text="{OblDetailData>OriginName}"/>  
                                     <Text id="_IDGenText144"  text="{OblDetailData>Destination}"/>  
                                     <Text id="_IDGenText145"  text="{OblDetailData>DestinationName}"/>  
                                     <Text id="_IDGenText146"  text="{OblDetailData>ModeOfTransport}"/>  
                                     <Text id="_IDGenText147"  text="{OblDetailData>ModeOfTransportText}"/>  
