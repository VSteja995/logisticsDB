            </VBox>
        </layout:Splitter>
        <!-- ROW 2 : Inventory | Selected Items -->
        <layout:Splitter id="botSplit" orientation="Horizontal" >

            <!-- Inventory section -->
            <VBox id="invBox" class="splitterSection">
                <layoutData>
                    <layout:SplitterLayoutData id="invLay" size="50%"/>
                </layoutData>
                <Toolbar id="invBar" class="splitterSectionHeader">
                    <Title id="invTitle" text="Inventory" level="H4"/>
                    <ToolbarSpacer id="invSpc" ></ToolbarSpacer>
                    <!-- <MenuButton id="_IDGenMenuButton3" icon="sap-icon://excel-attachment" type="Transparent">
                        <menu>
                            <Menu id="_IDGenMenu2">
                                <MenuItem id="_IDGenMenuItem4" text="Export" press=".onExport"/>
                                <MenuItem id="_IDGenMenuItem5" text="Export As." press=".onExportAs"/>
                            </Menu>
                        </menu>
                    </MenuButton> -->
                    <Button id="entFullBtnI" press="onFullScreenToggle" icon="sap-icon://full-screen" type="Transparent"/>
                    
                </Toolbar>
                <ScrollContainer id="invScroll" horizontal="true" vertical="true" width="100%" height="100%" >
                    <Table id="invTbl"  mode="MultiSelect" fixedLayout="false" items="{/InvDetails}">
                        <columns>
                            <Column id="_IDGenColumn43"><header><Text id="_IDGenText42" text="Commodity"/></header></Column>
                            <Column id="_IDGenColumn44"><header><Text id="_IDGenText43" text=" Plant"/></header></Column>
                            <Column id="_IDGenColumn45"><header><Text id="_IDGenText44" text="Storage location"/></header></Column>
                            <Column id="_IDGenColumn46"><header><Text id="_IDGenText45" text="Bussiness Location Id"/></header></Column>
                            <Column id="_IDGenColumn47"><header><Text id="_IDGenText46" text="Location Name"/></header></Column>
                            <Column id="_IDGenColumn48"><header><Text id="_IDGenText47" text="OnHand Inventory"/></header></Column>
                            <Column id="_IDGenColumn49"><header><Text id="_IDGenText48" text="Inbound Qunatity"/></header></Column>
                            <Column id="_IDGenColumn50"><header><Text id="_IDGenText49" text="Outbound Qunatity"/></header></Column>
                        </columns>
                        <items>
                            <ColumnListItem id="123c" >
                                <cells>
                                <Text id="INV11" text="{Commodity}"></Text>
                                <Text id="INV12" text="{Plant}"></Text>
                                <Text id="INV12E" text="{StorageLocation}"></Text>
                                 <Text id="INV17" text="{LocId}"></Text>                                
                                <Text id="INV13" text="{UOM}"></Text>
                                <Text id="INV14" text="{OnHandInventory}"></Text>
                                <Text id="INV15" text="{InboundQuantity}"></Text>
                                <Text id="INV16" text="{OutboundQuantity}"></Text>
                                <!-- <Text id="INV18" text="{PlantName}"></Text>  -->
                               
