</Panel>

<Panel id="matchPanel" headerText="Matched Details" class="sapUiTinyMargin"  expandable="true" expanded="true">
<headerToolbar >

    <Toolbar id="matchBar" >
     <Title id="hdmdid"     text="Matched Positions"></Title>
    <ToolbarSpacer id="matchSpc" ></ToolbarSpacer>
    <Button id="nomBtn" text="Create Nominations" icon="sap-icon://add" type="Emphasized"></Button>
    <Button id="nomdelBtn" text="DeleteSelected" icon="sap-icon://delete" type="Reject"></Button>
    <Button id="nomref" text="Refresh" icon="sap-icon://refresh" type="Ghost"></Button>
    </Toolbar>
</headerToolbar>
    <Toolbar id="idtbmb">
        <Title id="tmd2m" text="Matched Positions ( )" > </Title>
        <ToolbarSpacer id="mdspacer" ></ToolbarSpacer>
                            <MenuButton id="_IDGenMenuButtonmd3" icon="sap-icon://excel-attachment" type="Transparent">
                        <menu>
                            <Menu id="_IDGenMenumd2">
                                <MenuItem id="_IDGenMenuItemd4" text="Export" press=".onExport"/>
                                <MenuItem id="_IDGenMenuItemd5" text="Export As." press=".onExportAs"/>
                            </Menu>
                        </menu>
                    </MenuButton>
                    <Button id="entFullBtnImd" press="onFullScreenToggle" icon="sap-icon://full-screen" type="Transparent"/>

    </Toolbar>

