                            <Column id="_IDGenColumn66"><header><Text id="_IDGenText65" text="Planned Qunatity"/></header></Column>
                            <Column id="_IDGenColumn67"><header><Text id="_IDGenText66" text="Planned UOM"/></header></Column>
                            <Column id="_IDGenColumn68"><header><Text id="_IDGenText67" text="Source"/></header></Column>
                            <Column id="_IDGenColumn69"><header><Text id="_IDGenText68" text="Status"/></header></Column>
                            <Column id="_IDGenColumn70"><header><Text id="_IDGenText69" text="Delete"/></header></Column>

                        </columns>
                    </Table>
                </ScrollContainer>
            </VBox>

        </layout:Splitter>
     </layout:Splitter>
    </Panel>
<Panel id="monthPanel" class="sapUiTinyMargin" headerText="Monthly Planning Summary" expandable="true" expanded="true">
    <headerToolbar>
        <Toolbar id="monthBar" >
           <Title id="idmpt1" text="Monthly Planning Summary">  </Title>  
            <DateRangeSelection id="monthDrs" width="15rem" placeholder="MM/DD/YYYY - MM/DD/YYYY"></DateRangeSelection>
