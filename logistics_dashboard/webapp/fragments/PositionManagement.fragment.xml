                    <Button id="collapseBtn" icon="sap-icon://collapse-group"  type="Transparent"/>
 
                    <Button id="confirmMatchBtn"  text="Confirm-Match" icon="sap-icon://accept" type="Accept"/> 
                    <Button id="clearSelBtn" text="Clear-All" icon="sap-icon://decline"  type="Ghost" />   
                    <Button id="selFullBtnSE" press="onFullScreenToggle" icon="sap-icon://full-screen" type="Transparent" />
                </Toolbar>
                <ScrollContainer id="selScroll" horizontal="true" vertical="true" width="100%" height="100%">
                    <Table id="selTbl" fixedLayout="false">
                        <columns>
                            <Column id="_IDGenColumn51"><header><Text id="_IDGenText50" text="Deal ID"/></header></Column>
                            <Column id="_IDGenColumn52"><header><Text id="_IDGenText51" text=" Doc.no"/></header></Column>
                            <Column id="_IDGenColumn53"><header><Text id="_IDGenText52" text="Doc item"/></header></Column>
                            <Column id="_IDGenColumn54"><header><Text id="_IDGenText53" text="Commodity"/></header></Column>
                            <Column id="_IDGenColumn55"><header><Text id="_IDGenText54" text=" Quantity"/></header></Column>
                            <Column id="_IDGenColumn56"><header><Text id="_IDGenText55" text="VOM"/></header></Column>
                            <Column id="_IDGenColumn57"><header><Text id="_IDGenText56" text="Tx Type"/></header></Column>
                            <Column id="_IDGenColumn58"><header><Text id="_IDGenText57" text="Inco terms"/></header></Column>
