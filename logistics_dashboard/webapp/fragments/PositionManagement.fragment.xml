                            <Column id="_IDGenColumn2"><header><Text id="_IDGenText1" text="Commodity"/></header></Column>
                            <Column id="_IDGenColumn3"><header><Text id="_IDGenText2" text="Purchase Document"/></header></Column>
                            <Column id="_IDGenColumn4"><header><Text id="_IDGenText3" text="Purchase Item"/></header></Column>
                            <Column id="_IDGenColumn5"><header><Text id="_IDGenText4" text="Purchase Quantity"/></header></Column>
                            <Column id="_IDGenColumn6"><header><Text id="_IDGenText5" text="MatchQunatity"/></header></Column>
                            <Column id="_IDGenColumn7"><header><Text id="_IDGenText6" text="Delivery Date"/></header></Column>
                            <Column id="_IDGenColumn8"><header><Text id="_IDGenText7" text="Delivery Month"/></header></Column>
                            <Column id="_IDGenColumn9"><header><Text id="_IDGenText8" text="Transaction Type"/></header></Column>
                            <Column id="_IDGenColumn10"><header><Text id="_IDGenText9" text="Week Id"/></header></Column>
                            <Column id="_IDGenColumn11"><header><Text id="_IDGenText10" text="Supplier"/></header></Column>
                            <Column id="_IDGenColumn12"><header><Text id="_IDGenText11" text="Supplier Id"/></header></Column>
                            <Column id="_IDGenColumn13"><header><Text id="_IDGenText12" text="Origin ID"/></header></Column>
                            <Column id="_IDGenColumn14"><header><Text id="_IDGenText13" text="Origin "/></header></Column>
                            <Column id="_IDGenColumn15"><header><Text id="_IDGenText14" text="Destination ID"/></header></Column>
                            <Column id="_IDGenColumn16"><header><Text id="_IDGenText15" text="Destination "/></header></Column>
                            <Column id="_IDGenColumn17"><header><Text id="_IDGenText16" text="MarketZone"/></header></Column>
                            <Column id="_IDGenColumn18"><header><Text id="_IDGenText17" text="MarketZone ID"/></header></Column>
                            <Column id="_IDGenColumn19"><header><Text id="_IDGenText18" text="MOT"/></header></Column>
                            <Column id="_IDGenColumn20"><header><Text id="_IDGenText19" text="Mode of transportation"/></header></Column>
                            <Column id="_IDGenColumn21"><header><Text id="_IDGenText20" text="Inco Terms"/></header></Column>
                        </columns>
                        <items>
                            <ColumnListItem id="123a" >
                                <cells>
                                    <Text id="_IDGenText111" text="{EntDetailData>DealNumber}"></Text>
                                    <Text id="_IDGenText112" text="{EntDetailData>CommodityDesc}"></Text>
                                    <Text id="_IDGenText113" text="{EntDetailData>DocumentNumber}"></Text>
                                    <Text id="_IDGenText114" text="{EntDetailData>DocumentItem}"></Text>
                                    <Text id="_IDGenText115" text="{EntDetailData>PurchaseQuantity}"></Text>
                                    <Text id="_IDGenText116" text="{EntDetailData>MatchQuantity}"></Text>
                                    <Text id="_IDGenText117" text="{
                                    path: 'EntDetailData>DeliveryDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: {
                                          pattern: 'yyyy/MMM/dd'     
                                    }
                                    }" ></Text>
                                    <Text id="_IDGenText118" text="{EntDetailData>ScheduleMonth}"></Text>
                                    <Text id="_IDGenText119" text="{EntDetailData>TransactionType}"></Text>
                                    <Text id="_IDGenText120" text="{EntDetailData>WeekID}"></Text>
                                    <Text id="_IDGenText121" text="{EntDetailData>Supplier}"></Text>
                                    <Text id="_IDGenText122" text="{EntDetailData>SupplierID}"></Text>
                                    <Text id="_IDGenText123" text="{EntDetailData>Origin}"></Text>
                                    <Text id="_IDGenText124" text="{EntDetailData>OriginName}"></Text>
                                    <Text id="_IDGenText125" text="{EntDetailData>Destination}"></Text>
                                    <Text id="_IDGenText126" text="{EntDetailData>DestinationName}"></Text>
                                    <Text id="_IDGenText127" text="{EntDetailData>Marketzone}"></Text>
                                    <Text id="_IDGenText128" text="{EntDetailData>MarketzoneName}"></Text>
                                    <Text id="_IDGenText129" text="{EntDetailData>ModeOfTransport}"></Text>
                                    <Text id="_IDGenText130" text="{EntDetailData>ModeOfTransportText}"></Text>
                                    <Text id="_IDGenText131" text="{EntDetailData>IncoTerms}"></Text>
                                    <Text id="_IDGenText132" text="{EntDetailData>Commodity}"></Text>
                                    
                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>
                   
                    </smartTable:SmartTable>
                     </ScrollContainer>
                
            </VBox>

            <!-- Obligations section -->
            <VBox id="oblBox" class="splitterSection">
                <layoutData>
                    <layout:SplitterLayoutData id="oblLay" size="50%"/>
                </layoutData>
                <Toolbar id="oblBar" class="splitterSectionHeader">
                    <Title id="oblTitle" text="Obligations" level="H4"/>
                    <ToolbarSpacer id="oblSpc" ></ToolbarSpacer>
                     <Button id="entFullBtnI34" press="onFullScreenToggle" icon="sap-icon://full-screen" type="Transparent"/>
                </Toolbar>
                    <smartTable:SmartTable
                        id="oblSmartTable"
                        entitySet="OblDetailSet"
                        tableType="ResponsiveTable"
                        enableExport="false"
                        useVariantManagement="false"
                        useTablePersonalisation="false"
