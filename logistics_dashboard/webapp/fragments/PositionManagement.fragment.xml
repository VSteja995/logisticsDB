         PANEL 1 : Filters + KPI Summary Cards
    
    <Panel id="panelPlanningSummary" class="sapUiTinyMargin"> 

        <!-- Filter Row -->
        <HBox id="hboxFilterRow" alignItems="Center" justifyContent="SpaceBetween"
              class="filterContainer sapUiSmallMargin">
            <Text id="textPlanningSummary" text="Planning Summary" class="filterText"/>
            <Label id="labelDateRange" text="DateRange :"/>
            <DateRangeSelection id="dateRangeSelection" placeholder="MM/DD/YYYY - MM/DD/YYYY"/>
            <Label id="labelMode" text="Mode :"/>
            <SegmentedButton id="segmentedButtonMode" selectedKey="All">
                <items>
                    <SegmentedButtonItem id="segmentedButtonItemTrain" key="Train" icon="sap-icon://cargo-train"/>
                    <SegmentedButtonItem id="segmentedButtonItemTruck" key="Truck" icon="sap-icon://shipping-status"/>
                </items>
            </SegmentedButton>
            <Label id="labelCommodity" text="Commodity :"/>
            <MultiComboBox id="comboCommodity" placeholder="Select Commodity" width="100%">
                <items>
                    <core:Item id="itemCommodityGas87" key="GAS87" text="GAS87"/>
                    <core:Item id="itemCommodityGas88" key="GAS88" text="GAS88"/>
                </items>
            </MultiComboBox>
            <Label id="labelMarketZone" text="Market Zone :"/>
            <MultiComboBox id="comboMarketZone" placeholder="All Zones" width="100%">
                <items>
                    <core:Item id="itemMarketZoneGas87" key="GAS87" text="GAS87"/>
                    <core:Item id="itemMarketZoneGas88" key="GAS88" text="GAS88"/>
                </items>
            </MultiComboBox>
        </HBox>

        <!-- KPI Cards -->
        <HBox id="hboxKpiCards" wrap="Wrap">
            <VBox id="vboxTotalEntitlements" class="kpiCard green-border sapUiSmallMarginEnd">
                <Text id="textTotalEntitlementsLabel" text="Total Entitlements" class="kpiLabel"/>
                <Title id="titleTotalEntitlementsValue" text="2,40,000" class="kpiValue"/>
                <Text id="textTotalEntitlementsSubtext" text="6 positions" class="kpiSubtext"/>
                
                <core:Icon id="iconTotalEntitlements" size="25px" src="sap-icon://trend-up"  color="#2b7d2b"/>
            </VBox>
            <VBox id="vboxTotalObligations" class="kpiCard red-border sapUiSmallMarginEnd">
                <Text id="textTotalObligationsLabel" text="Total Obligations" class="kpiLabel"/>
                <Title id="titleTotalObligationsValue" text="2,02,000" class="kpiValue"/>
                <Text id="textTotalObligationsSubtext" text="6 positions" class="kpiSubtext"/>
                <core:Icon id="iconTotalObligations" size="25px" src="sap-icon://trend-down"  color="#fb0404"/>
            </VBox>
            <VBox id="vboxTotalPlanned" class="kpiCard blue-border sapUiSmallMarginEnd">
                <Text id="textTotalPlannedLabel" text="Total Planned" class="kpiLabel"/>
                <Title id="titleTotalPlannedValue" text="2,02,000" class="kpiValue"/>
                <Text id="textTotalPlannedSubtext" text="6 positions" class="kpiSubtext"/>
                <core:Icon id="iconTotalPlanned" size="25px" src="sap-icon://select-appointments"  color="#048ef7"/>
            </VBox>
            <VBox id="vboxNetPosition" class="kpiCard green-border sapUiSmallMarginEnd">
                <Text id="textNetPositionLabel" text="Net Position" class="kpiLabel"/>
                <Title id="titleNetPositionValue" text="2,02,000" class="kpiValue"/>
                <Text id="textNetPositionSubtext" text="6 positions" class="kpiSubtext"/>
               
            </VBox>
        </HBox>

