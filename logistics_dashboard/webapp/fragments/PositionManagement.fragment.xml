                            </ColumnListItem>
                        </items>

                    </Table>
                   
                    <!-- </smartTable:SmartTable> -->
                     </ScrollContainer>
                
            </VBox>

            <!-- Obligations section -->
            <VBox id="oblBox" class="splitterSection">
                <layoutData>
                    <layout:SplitterLayoutData id="oblLay" size="50%"/>
                </layoutData>
                <Toolbar id="oblBar" class="splitterSectionHeader">
                    <Title id="oblTitle" text="Demand" level="H4"/>
                    <ToolbarSpacer id="oblSpc" ></ToolbarSpacer>
                     <Button id="entFullBtnI34" press="onFullScreenToggle" icon="sap-icon://full-screen" type="Transparent"/>
                </Toolbar>
                <!-- <smartTable:SmartTable
                        id="entSmartTable"
