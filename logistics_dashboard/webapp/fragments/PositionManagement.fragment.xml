                       > -->
                <ScrollContainer id="oblScroll" horizontal="true" vertical="true" width="100%" height="100%" >    
                        <Table id="oblTbl" fixedLayout="false" items="{OblDetailData>/OblDetailSet}" mode="MultiSelect" selectionChange="onSelectionChangeOBL" >
                        <columns>
