                        entitySet="EntDetailSet"
                        tableType="Table"
                        enableExport="false"
                        useVariantManagement="false"
                        useTablePersonalisation="false"
                        beforeRebindTable="onBeforeRebindEntitlementsTable"
                        showRowCount="true"
                        enableAutoBinding="false"
                        enableCopy="false"   
                        editable="false"
                        showFullScreenButton="false"
