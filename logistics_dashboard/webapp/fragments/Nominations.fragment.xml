<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout">

    <!-- ═══════════════════════════════════════════════════════
         PANEL 1 : Nomination Filters
         ═══════════════════════════════════════════════════════ -->
    <Panel id="NomPnl1Pnl001" class="sapUiTinyMargin">

        <!-- Row 1: Deal ID | Nomination ID | Deal Type | Commodity | Location | Status  | Scheduled Date From | Scheduled Date To -->
        <HBox id="NomPnl1Hbx002" alignItems="End" wrap="Wrap"
              class="filterContainer sapUiSmallMargin">

            <VBox id="NomPnl1Vbx003" class="sapUiSmallMarginEnd">
                <Label id="NomPnl1Lbl004" text="Deal ID :" />
                <Input id="NomPnl1Inp005" placeholder="Search Deal Id" width="8rem" liveChange="onNominationSearch"/>
            </VBox>

            <VBox id="NomPnl1Vbx006" class="sapUiSmallMarginEnd">
                <Label id="NomPnl1Lbl007" text="Nomination ID :"/>
                <Input id="NomPnl1Inp008" placeholder="Search Nominations Id" width="9rem" liveChange="onNominationSearch"/>
            </VBox>

            <!-- <VBox id="NomPnl1Vbx009" class="sapUiSmallMarginEnd">
                <Label id="NomPnl1Lbl010" text="Deal Type :"/>
                <Select id="NomPnl1Sel011" width="8rem">
                    <core:Item id="NomPnl1Ite012" key="" text="None"/>
                    <core:Item id="NomPnl1Ite013" key="Purchase" text="Purchase"/>
                    <core:Item id="NomPnl1Ite014" key="Sales" text="Sales"/>
                    <core:Item id="NomPnl1Ite015" key="Swap" text="Swap"/>
                </Select>
            </VBox> -->

            <VBox id="NomPnl1Vbx016" class="sapUiSmallMarginEnd">
                <Label id="NomPnl1Lbl017" text="Commodity"/>
             <Select
    id="NomPnl1Sel018"
    width="8rem"
    selectedKey=""
    change=".onNominationDropdownChange"
    items="{UniqNomCmdtyData>/UniqNomCmdtySet}">

    <core:Item
        id="NomPnl1Ite019"
        key="{UniqNomCmdtyData>Commodity}"
        text="{UniqNomCmdtyData>CommodityName}" />

</Select>
            </VBox>

            <VBox id="NomPnl1Vbx023" class="sapUiSmallMarginEnd">
                <Label id="NomPnl1Lbl024" text="Location"/>
              <Select
    id="NomPnl1Sel025"
    width="8rem"
    selectedKey=""
    change=".onNominationDropdownChange"
    items="{UniqNomLocData>/UniqNomLocSet}">

    <core:Item
        id="NomPnl1Ite026"
        key="{UniqNomLocData>LocationId}"
        text="{UniqNomLocData>LocationName}" />

</Select>
            </VBox>

            <VBox id="NomPnl1Vbx031" class="sapUiSmallMarginEnd">
                <Label id="NomPnl1Lbl032" text="Status"/>
            <Select
    id="NomPnl1Sel033"
    width="8rem"
    selectedKey=""
    change=".onNominationDropdownChange"
    items="{UniqNomStatData>/UniqNomStatSet}">

    <core:Item
        id="NomPnl1Ite034"
        key="{UniqNomStatData>Status}"
        text="{UniqNomStatData>StatusDescription}" />

</Select>
            </VBox>
            <VBox id="NomPnl1Vbx039" class="sapUiSmallMarginEnd">
            <Label id="_IDGenLabel24"  text="DateRange :"></Label>
                    <DateRangeSelection id="_IDGenDateRangeSelection"
                        displayFormat="MM/dd/yyyy"
                        placeholder="MM/DD/YYYY - MM/DD/YYYY"
                         change=".onNominationDateRangeChange" />
            </VBox>

        </HBox>

        

    </Panel>

    <!-- ═══════════════════════════════════════════════════════
         PANEL 2 : Nominations Details Table
         ═══════════════════════════════════════════════════════ -->
    <Panel id="NomPnl2Pnl045" class="sapUiTinyMargin planclass">

        <headerToolbar>
            <OverflowToolbar id="NomPnl2Tbr046">
                <ToolbarSpacer id="NomPnl2Too047"/>
                
                <Button id="NomPnl2Btn048"
                        text="Cancel Nominations"
                        icon="sap-icon://decline"
                        type="Reject" press="navToCreateNomination"/>
                <Button id="NomPnl2Btn049"
                        text="Create Ticket"
                        icon="sap-icon://add"
                        press="navToCreateTicket"/>
                <Button id="NomPnl2Btn050"
                        text="Refresh"
                        icon="sap-icon://refresh"
                        type="Ghost"
                        press="onNominationRefresh"/>
            </OverflowToolbar>
        </headerToolbar>
        <VBox id="NomPnl2Vbx051" class="dealsFlexBody">
            <OverflowToolbar id="NomPnl2Tbr052" >
                    <Title id="NomPnl2Ttl053" text="Nominations Details"/>
                    <ToolbarSpacer id="NomPnl2Too054" ></ToolbarSpacer>
                    <Button id="NomPnl2Btn060" icon="{= ${view>/isNomDetailsFullScreen} ? 'sap-icon://exit-full-screen' : 'sap-icon://full-screen'}" tooltip="{= ${view>/isNomDetailsFullScreen} ? 'Exit Full Screen' : 'Full Screen'}" type="Transparent" press=".onNominationTableToggleFullScreen"/>

                </OverflowToolbar>
        <ScrollContainer id="NomPnl2Scr061" height="280px" class="dealsTableWrapper" horizontal="true" vertical="true" width="100%">
            <Table id="NomPnl2Tbl062"
             mode="MultiSelect"
              fixedLayout="false"
               noDataText="No data"
               items="{NomDetailsData>/NomDetailsSet}" sticky="ColumnHeaders,HeaderToolbar" >
                <columns>
                    <Column id="NomPnl2Col063"      ><header><Text id="NomPnl2Txt064"       text="Deal Number"/></header></Column>
                    <Column id="NomPnl2Col065"          ><header><Text id="NomPnl2Txt066"           text="Nomination Key"/></header></Column>
                    <Column id="NomPnl2Col067"         ><header><Text id="NomPnl2Txt068"          text="Nomination Item"/></header></Column>
                    <Column id="NomPnl2Col069"         ><header><Text id="NomPnl2Txt070"          text="Commodity"/></header></Column>
                    <Column id="NomPnl2Col071"          ><header><Text id="NomPnl2Txt072"           text="Status"/></header></Column>
                    <Column id="NomPnl2Col073"          ><header><Text id="NomPnl2Txt074"           text="Ticket"/></header></Column>
                    <Column id="NomPnl2Col075"          ><header><Text id="NomPnl2Txt076"           text="Ticket Item"/></header></Column>
                    <Column id="NomPnl2Col077"          ><header><Text id="NomPnl2Txt078"           text="Ticket Version"/></header></Column>
                    <Column id="NomPnl2Col079"          ><header><Text id="NomPnl2Txt080"           text="Ticket Start Number"/></header></Column>


                    <Column id="NomPnl2Col081"    ><header><Text id="NomPnl2Txt082"     text="Schedule Date"/></header></Column>
                    <Column id="NomPnl2Col083"      ><header><Text id="NomPnl2Txt084"       text="Loaction ID"/></header></Column>
                    <Column id="NomPnl2Col085"        ><header><Text id="NomPnl2Txt086"         text="Loaction"/></header></Column>
                    <!-- <Column id="NomPnl2Col087"    ><header><Text id="NomPnl2Txt088"     text="MarketZone ID"/></header></Column> -->
                    <!-- <Column id="NomPnl2Col089"      ><header><Text id="NomPnl2Txt090"       text="Market Zone"/></header></Column> -->
                    <Column id="NomPnl2Col091"      ><header><Text id="NomPnl2Txt092"       text="Planned Schedule Qty"/></header></Column>
                    <Column id="NomPnl2Col093"             ><header><Text id="NomPnl2Txt094"              text="Actualized Qunatity"/></header></Column>
                 
                     <Column id="NomPnl2Col097"        ><header><Text id="NomPnl2Txt098"         text="Scheduled Material"/></header></Column>
                        <Column id="NomPnl2Col095"         ><header><Text id="NomPnl2Txt096"          text="Carrier/Pipline"/></header></Column>
                    <Column id="NomPnl2Col099"    ><header><Text id="NomPnl2Txt100"     text="Counterparty"/></header></Column>
                    <Column id="NomPnl2Col101"       ><header><Text id="NomPnl2Txt102"        text="Contractt Number"/></header></Column>
                </columns>
                <items>
                    <ColumnListItem id="NomPnl2ClL103" type="Inactive">
                      <cells>

    <Text id="_IDGenText68" text="{NomDetailsData>DealNumber}"/>

    <Text id="_IDGenText69" text="{NomDetailsData>NominationKey}"/>

    <Text id="_IDGenText110" text="{NomDetailsData>NominationItem}"/>

    <Text id="_IDGenText132" text="{NomDetailsData>CommodityName}"/>

    <ObjectStatus id="_IDGenObjectStatus3"
        text="{NomDetailsData>StatusDescription}"
        state="{= ${NomDetailsData>StatusDescription} === 'Confirmed'
            ? 'Success'
            : ${NomDetailsData>StatusDescription} === 'Pending'
            ? 'Warning'
            : 'None'}"/>

    <Text id="_IDGenText149" text="{NomDetailsData>TicketKey}"/>

    <Text id="_IDGenText150" text="{NomDetailsData>TicketItem}"/>

    <!-- Ticket Version not available -->
    <Text id="_IDGenText151" text="-"/>

    <!-- Ticket Start Number not available -->
    <Text id="_IDGenText152" text="-"/>

    <Text id="_IDGenText153"  text="{
                path: 'NomDetailsData>ScheduleDate',
                type: 'sap.ui.model.type.Date', 
                formatOptions: {
                      pattern: 'yyyy/MMM/dd' 
                      }
                      }"/>

    <Text id="_IDGenText154" text="{NomDetailsData>Locationid}"/>

    <Text id="_IDGenText155" text="{NomDetailsData>LocationName}"/>

    <!-- MarketZone ID not available -->
    <Text id="_IDGenText156" text="-"/>

    <!-- Market Zone not available -->
    <Text id="_IDGenText157" text="-"/>

    <Text id="_IDGenText158" text="{NomDetailsData>ScheduledQuantity}"/>

    <Text id="_IDGenText159" text="{NomDetailsData>ActualScheduleQuantity}"/>

    <Text id="_IDGenText160" text="{NomDetailsData>ScheduleProduct}"/>

    <Text id="_IDGenText161" text="{NomDetailsData>CarrierName}"/>

    <Text id="_IDGenText162" text="{NomDetailsData>BusinessPartnerName}"/>

    <Text id="_IDGenText163" text="{NomDetailsData>ContractNumber}"/>

</cells>
</ColumnListItem>
    </items>
      </Table>
        </ScrollContainer>
    </VBox>
    </Panel>
    <!-- ═══════════════════════════════════════════════════════
         PANEL 3 : Ticket Details Table
         ═══════════════════════════════════════════════════════ -->
    <Panel id="NomPnl3Pnl120" class="sapUiTinyMargin planclass">

        <headerToolbar>
            <OverflowToolbar id="NomPnl3Tbr121">
               
                <ToolbarSpacer id="NomPnl3Too122"/>
                
                <Button id="NomPnl3Btn123"
                        text="Cancel Ticket"
                        icon="sap-icon://decline"
                        type="Reject"
                        press="navToCreateTicket"/>
                <Button id="NomPnl3Btn124"
                        text="Reverse Ticket"
                        icon="sap-icon://undo"
                        press="navToReverseTicket"/>
                <Button id="NomPnl3Btn125"
                        text="Upload File"
                        icon="sap-icon://upload"
                        press="navToUploadTicket"/>
                <Button id="NomPnl3Btn126"
                        text="Refresh"
                        icon="sap-icon://refresh"
                        type="Ghost"
                          press="onTicketRefresh"/>
            </OverflowToolbar>
        </headerToolbar>
        <VBox id="NomPnl3Vbx126" class="dealsFlexBody">
            <OverflowToolbar id="NomPnl3Tbr127" >
             <Title id="NomPnl3Ttl128" text="Ticket Details"/>
                <ToolbarSpacer id="NomPnl3Too129" ></ToolbarSpacer>
                <Button id="NomPnl3Btn135" icon="{= ${view>/isTicketDetailsFullScreen} ? 'sap-icon://exit-full-screen' : 'sap-icon://full-screen'}" tooltip="{= ${view>/isTicketDetailsFullScreen} ? 'Exit Full Screen' : 'Full Screen'}" type="Transparent" press=".onTicketTableToggleFullScreen"/>
            </OverflowToolbar>
            <ScrollContainer id="NomPnl3Scr136" height="280px" class="dealsTableWrapper" horizontal="true" vertical="true" width="100%">
            <Table id="NomPnl3Tbl137" 
            mode="MultiSelect"
             fixedLayout="false"
              noDataText="No data"
              items="{TicketDetailsData>/TicketDetailsSet}" sticky="ColumnHeaders,HeaderToolbar">
               <columns>

        <Column id="NomPnl3Col138">
            <header>
                <Text
                    id="NomPnl3Txt139"
                    text="Ticket Key"/>
            </header>
        </Column>

        <Column id="NomPnl3Col140">
            <header>
                <Text
                    id="NomPnl3Txt141"
                    text="Nom. Doc Number"/>
            </header>
        </Column>

        <Column id="NomPnl3Col142">
            <header>
                <Text
                    id="NomPnl3Txt143"
                    text="Ticket Item"/>
            </header>
        </Column>

        <Column id="NomPnl3Col144">
            <header>
                <Text
                    id="NomPnl3Txt145"
                    text="Ticket Extension Number"/>
            </header>
        </Column>

        <Column id="NomPnl3Col146">
            <header>
                <Text
                    id="NomPnl3Txt147"
                    text="Nomination Item"/>
            </header>
        </Column>

        <Column id="NomPnl3Col148">
            <header>
                <Text
                    id="NomPnl3Txt149"
                    text="Ticket Version"/>
            </header>
        </Column>

        <Column id="NomPnl3Col150">
            <header>
                <Text
                    id="NomPnl3Txt151"
                    text="Location ID"/>
            </header>
        </Column>

        <Column id="NomPnl3Col152">
            <header>
                <Text
                    id="NomPnl3Txt153"
                    text="Vehicle ID"/>
            </header>
        </Column>

        <Column id="NomPnl3Col154">
            <header>
                <Text
                    id="NomPnl3Txt155"
                    text="Ticket Quantity"/>
            </header>
        </Column>

        <Column id="NomPnl3Col156">
            <header>
                <Text
                    id="NomPnl3Txt157"
                    text="Ticket Material"/>
            </header>
        </Column>

        <Column id="NomPnl3Col158">
            <header>
                <Text
                    id="NomPnl3Txt159"
                    text="Ticket Posting Date"/>
            </header>
        </Column>

        <Column id="NomPnl3Col160">
            <header>
                <Text
                    id="NomPnl3Txt161"
                    text="Ticket Start Date Time"/>
            </header>
        </Column>

        <Column id="NomPnl3Col162">
            <header>
                <Text
                    id="NomPnl3Txt163"
                    text="Ticket End Date Time"/>
            </header>
        </Column>

        <Column id="NomPnl3Col164">
            <header>
                <Text
                    id="NomPnl3Txt165"
                    text="Ticket Created By User"/>
            </header>
        </Column>

        <Column id="NomPnl3Col166">
            <header>
                <Text
                    id="NomPnl3Txt167"
                    text="Ticket Change Date"/>
            </header>
        </Column>

    </columns>


             <items>

        <ColumnListItem
            id="NomPnl3ClL168"
            type="Inactive">

            <cells>

                <!-- 1 -->
                <Text
                    id="NomPnl3Txt169"
                    text="{TicketDetailsData>TicketKey}"/>

                <!-- 2 -->
                <Text
                    id="NomPnl3Txt170"
                    text="{TicketDetailsData>NomDocNumber}"/>

                <!-- 3 -->
                <Text
                    id="NomPnl3Txt171"
                    text="{TicketDetailsData>TicketItem}"/>

                <!-- 4 -->
                <Text
                    id="NomPnl3Txt172"
                    text="{TicketDetailsData>TicketExtNumber}"/>

                <!-- 5 -->
                <Text
                    id="NomPnl3Txt172a"
                    text="{TicketDetailsData>NomDocItem}"/>

                <!-- 6 -->
                <Text
                    id="NomPnl3Txt173"
                    text="{TicketDetailsData>TicketVersion}"/>

                <!-- 7 -->
                <Text
                    id="NomPnl3Txt174"
                    text="{TicketDetailsData>LocationId}"/>

                <!-- 8 -->
                <Text
                    id="NomPnl3Txt175"
                    text="{TicketDetailsData>VehicleId}"/>

                <!-- 9 -->
                <Text
                    id="NomPnl3Txt176"
                    text="{TicketDetailsData>TicketQuantity}"/>

                <!-- 10 -->
                <Text
                    id="NomPnl3Txt177"
                    text="{TicketDetailsData>TicketMaterial}"/>

                <!-- 11 -->
                <Text
                    id="NomPnl3Txt178" text="{
                path: 'TicketDetailsData>TicketPostingDate',
                type: 'sap.ui.model.type.Date', 
                formatOptions: {
                      pattern: 'yyyy/MMM/dd' 
                      }
                      }"/>

                <!-- 12 -->
                <Text
                    id="NomPnl3Txt179"
                     text="{TicketDetailsData>TicketStartDateTime}"/>

                <!-- 13 -->
                <Text
                    id="NomPnl3Txt180"
                     text="{TicketDetailsData>TicketEndDateTime}"/>

                <!-- 14 -->
                <Text
                    id="NomPnl3Txt181"
                    text="{TicketDetailsData>TicketCreatedBy}"/>

                <!-- 15 -->
                <Text
                    id="NomPnl3Txt182"
                          text="{
                path: 'TicketDetailsData>TicketChangedDate',
                type: 'sap.ui.model.type.Date', 
                formatOptions: {
                      pattern: 'yyyy/MMM/dd' 
                      }
                      }"/>

            </cells>

        </ColumnListItem>

    </items>

            </Table>
        </ScrollContainer>
        </VBox>
    </Panel>
    

</core:FragmentDefinition>