<mvc:View controllerName="genslogiques.logisticsdashboard.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    >
 <Page id="MainPnlPg001"  title="{i18n>title}"  titleAlignment="Center" titleLevel="H1">
    <VBox id="MainPnlVbx002" class="headerBanner">  
        <HBox id="MainPnlHbx003">
            <VBox id="MainPnlVbx004" class="sapUiMediumMarginEnd"> <Image id="MainPnlImg005"  class="c_logo" src="../Images/Gens-logo.png"></Image></VBox>
            <VBox id="MainPnlVbx006" >
                <Title id="MainPnlTtl007" text="Deal Obligation &amp; Entitlement Management" titleStyle="H2" class="headerTitle" />
                <Text id="MainPnlTxt008" text="Manage and monitor your physical deals, obligations, and entitlements" class="headerSubtitle" />
            </VBox>
        </HBox>
    </VBox>

        <IconTabBar id="MainPnlITB009"
            class="brandIconTabBar"
            headerMode="Inline"
            >
            <items>
                <IconTabFilter id="MainPnlITF010" text="Deals Overview" key="deals" icon="sap-icon://document">
                           <core:Fragment id="MainPnlFra011" fragmentName = "genslogiques.logisticsdashboard.fragments.DealsOverview" type = "XML" />
                </IconTabFilter>
               <IconTabFilter id="MainPnlITF012" text="Logistics Planning" key="position" icon="sap-icon://vertical-bar-chart-2">
                       <core:Fragment id="MainPnlFra013" fragmentName = "genslogiques.logisticsdashboard.fragments.PositionManagement" type = "XML" />
                </IconTabFilter>
                <IconTabFilter id="MainPnlITF014" text="Nominations" key="nominations" icon="sap-icon://activity-individual">
                       <core:Fragment id="MainPnlFra015" fragmentName = "genslogiques.logisticsdashboard.fragments.Nominations" type = "XML" />
                </IconTabFilter>
              
            </items>
        </IconTabBar>
    </Page>
</mvc:View>