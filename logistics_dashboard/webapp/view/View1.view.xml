<mvc:View controllerName="genslogiques.logisticsdashboard.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    >
    <Page id="_IDGenPage1" title="{i18n>title}">
    <VBox id="_IDGenVBox1" class="sapUiMediumMargin header" >    
        <Title id="_IDGenTitle" text="Deal Obligation &amp; Entitlement Management" titleStyle="H2"  />
        <Text id="_IDGenText" text="Manage and monitor your physical deals, obligations, and entitlements" />
    </VBox>

        <IconTabBar id="idIconTabBar"
            
            headerMode="Inline"
            
           
           
            >
        
            <items>
                <IconTabFilter id="_IDGenIconTabFilter" text="Deals Overview" key="deals" icon="sap-icon://document">
                           <core:Fragment id="_IDGenFragment" fragmentName = "genslogiques.logisticsdashboard.fragments.DealsOverview" type = "XML" />
                </IconTabFilter>
               <IconTabFilter id="_IDGenIconTabFilter2" text="Logistics Planning" key="position" icon="sap-icon://vertical-bar-chart-2">
                       <core:Fragment id="_IDGenFragment2" fragmentName = "genslogiques.logisticsdashboard.fragments.PositionManagement" type = "XML" />
                </IconTabFilter>
                <IconTabFilter id="_IDGenIconTabFilter3" text="Nominations" key="nominations" icon="sap-icon://activity-individual">
                       <core:Fragment id="_IDGenFragment3" fragmentName = "genslogiques.logisticsdashboard.fragments.Nominations" type = "XML" />
                </IconTabFilter>
                <IconTabFilter id="_IDGenIconTabFilter4" text="Logistics &amp; Tracking" key="logistics" icon="sap-icon://shipping-status">
                       <core:Fragment id="_IDGenFragment4" fragmentName = "genslogiques.logisticsdashboard.fragments.Logistics&amp;Tracking" type = "XML" />
                </IconTabFilter>
            </items>
        </IconTabBar>
    </Page>
</mvc:View>